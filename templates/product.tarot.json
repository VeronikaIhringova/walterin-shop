    "how_it_works": {
      "type": "how-it-works",
      "settings": {
        "title": "Every card is a nine-frame path",
        "paragraph_1": "Inspired by the original <strong>Rider–Waite</strong>, then redrawn the <em>Walterin way</em>: instead of one image, each card unfolds across <strong>nine frames</strong>. Look at the picture first. Then read the words.",
        "paragraph_2": "The cards do not hand you <strong>finished answers</strong>. They help you hear <em>what usually stays quiet</em>.",
        "card_asset": "hiw-card.jpg",
        "card_alt": "The Walterin nine-frame path",
        "background": "#e9e7df",
        "background_asset": "hiw-bg.jpg"
      }
    },
    "meet_walter": {
      "type": "meet-walter",
      "settings": {
        "heading": "Hi. My name is Walter Ihring.",
        "paragraph_1": "I devote my time to <strong>animated humour and caricatures</strong>. I like travelling, especially across India. My pictures also like travelling, especially for exhibitions in cities far away. On their return, they sometimes bring me an award as a souvenir from the competitions they had visited.",
        "paragraph_2": "On one hot day in summer, I was sipping my coffee in the square, watching tourists race from the town hall to the cathedral, hunting for the stories of the people who lived there. It was there that I decided to link sketching with history, travelling and humour — and create amusing illustrated guides. In 2015 I published my first, about my hometown, <strong>Walterin Bratislava</strong>.",
        "photo_asset": "wi-walter.jpg",
        "photo_alt": "Walter Ihring, the illustrator behind Walterin",
        "background": "#fffef7"
      }
    },
    "faq_with_image_gbXEDU": {
      "type": "faq-with-image",
      "blocks": {
        "faq_item_Y9KJjM": {
          "type": "faq_item",
          "settings": {
            "question": "When does it ship?",
            "answer": "<p>The first run of 150 decks goes to print soon. Order now and your deck ships the moment it lands — we'll email you the date.</p>"
          }
        },
        "faq_item_t4ADqG": {
          "type": "faq_item",
          "settings": {
            "question": "What language is the deck in?",
            "answer": "<p>The cards are illustration-led, so they speak in pictures first. Packaging and the little guide come in Slovak and English.</p>"
          }
        },
        "faq_item_8Ld73Y": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to know tarot?",
            "answer": "<p>Not at all. This is a set of illustrated stories on cards — read the picture, then the words. No experience required.</p>"
          }
        },
        "faq_item_cmGKaB": {
          "type": "faq_item",
          "settings": {
            "question": "Where do you ship?",
            "answer": "<p>Across the EU via Packeta. Slovakia and the rest of the EU at checkout; more regions to follow.</p>"
          }
        }
      },
