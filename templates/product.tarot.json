    "how_it_works": {
      "type": "how-it-works",
      "settings": {
        "title": "Every card is a nine‑frame path",
        "paragraph_1": "Inspired by the original <strong>Rider–⁠Waite</strong>, then redrawn the <em>Walterin way</em>: instead of one image, each card unfolds across <strong>nine frames</strong>. Look at the picture first. Then read the words.",
        "paragraph_2": "The cards do not hand you <strong>finished answers</strong>. They help you hear <em>what usually stays quiet</em>.",
        "card_asset": "hiw-card.jpg",
        "card_alt": "The Walterin nine‑frame path",
        "background": "#e9e7df",
        "background_asset": "hiw-bg.jpg"
      }
