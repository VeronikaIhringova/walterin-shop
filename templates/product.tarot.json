    "meet_walter": {
      "type": "meet-walter",
      "settings": {
        "heading": "Hi. My name is Walter Ihring.",
        "paragraph_1": "I devote my time to <strong>animated humour and caricatures</strong>. I like travelling, especially across India. My pictures also like travelling, especially for exhibitions in cities far away. On their return, they sometimes bring me an award as a souvenir from the competitions they had visited.",
        "paragraph_2": "On one hot day in summer, I was sipping my coffee in the square, watching tourists race from the town hall to the cathedral, hunting for the stories of the people who lived there. It was there that I decided to link sketching with history, travelling and humour — and create amusing illustrated guides. In 2015 I published my first, about my hometown, <strong>Walterin Bratislava</strong>.",
        "photo_asset": "wi-walter.jpg",
        "photo_alt": "Walter Ihring, the illustrator behind Walterin",
        "background": "#fffef7"
      }
    },
