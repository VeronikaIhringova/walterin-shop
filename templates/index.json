            "heading_color": "#222222",
            "text_color": "#666666",
            "accent_color": "#fce206",
            "icon_1": "shopify://shop_images/icons1_1.png",
            "icon_width_1": 60,
            "heading_1": "Short Stories",
            "preview_1": "<p>History, in its sharpest form. <br/>Five minutes or fifty, enter anywhere.</p>",
            "show_banner_1": false,
            "full_text_1": "<p>History, in its sharpest form. Five minutes or fifty, enter anywhere.<br/><br/>Each story unfolds in nine frames: precise, distilled, alive. Made for the spaces in between. <br/>And for moments you’d rather not rush.</p>",
            "expanded_background_1": "#fffdf7",
            "icon_2": "shopify://shop_images/Group_1066.png",
            "icon_width_2": 80,
            "heading_2": "Witty history",
            "preview_2": "<p>Sharp insights. Clean lines. <br/>A point of view.</p>",
            "show_banner_2": false,
            "full_text_2": "<p>Sharp insights. Clean lines. A point of view.<br/><br/>History told with timing, where observation meets nuance, and a single detail can tilt the whole perspective.<br/>The kind of knowledge that lingers longer than the page.</p>",
            "expanded_background_2": "#fffdf7",
            "icon_3": "shopify://shop_images/iconsbrushes_1.png",
            "icon_width_3": 70,
            "heading_3": "A UNIVERSAL LANGUAGE",
            "preview_3": "<p>Comics move where <br/>language hesitates.</p>",
            "show_banner_3": false,
            "full_text_3": "<p>Comics move where language hesitates.<br/><br/>Cities become symbols. Facts become scenes. Ideas travel lightly, but stay with you.<br/>This is history you don’t just read. You recognize it.<br/><br/></p>",
            "expanded_background_3": "#fffdf7"
          },
          "blocks": {}
        },
