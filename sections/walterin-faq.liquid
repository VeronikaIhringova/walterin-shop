{% comment %}
  Walterin · Frequently asked questions — two columns, after rhodeskin.com.

  Categories on the left that jump to their section; the questions as accordions on the right,
  grouped under a category heading. On a phone the left column becomes a compact row of category
  chips above the questions. Research: docs/design/FAQ-RESEARCH.md.

  WHY THE TEXT IS IN THE LOCALE FILES and not in section blocks.

  Blocks were the obvious choice and they are the wrong one here. A block setting is translated
  through Translate & Adapt, which is STORE data: the Slovak lives outside the repo, cannot be
  reviewed in a diff, and — measured on 7 Oct 2026 — had never been written, so /sk/pages/faq was
  serving twenty-one English answers to Slovak readers. Locale files make the two languages the
  same kind of object, versioned together, impossible to half-translate, and they need no store
  write to publish.

  The cost, stated plainly: Veronka cannot edit an answer in the theme editor any more. For a page
  whose every sentence has to agree with the Terms, that is a feature. Adding a question is a line
  in each locale file plus a key in the list below.

  Structure lives here, words live in locales/*.json:
    walterin.faq.cat.<category>            the category name
    walterin.faq.q.<category>_<key>.q      the question
    walterin.faq.q.<category>_<key>.a_html the answer, HTML, may contain links

  Two placeholders are replaced at render time so the links follow the locale and never rot:
    [WITHDRAW_URL]  ->  /pages/withdrawal, prefixed for the active locale
    [TERMS_URL]     ->  the shop's own Terms URL

  Nothing here may promise anything that is not in the Terms. Delivery windows, carriers and
  prices are not stated at all while clauses 6.1 and 6.2 are unwritten.
{% endcomment %}

{%- liquid
  assign cats = 'products,ebooks,orders,shipping,returns,contact' | split: ','

  comment
    Which questions sit in which category, in order. The only list to touch when adding one.
  endcomment
  assign q_products = 'who,tarot,prague,restock' | split: ','
  assign q_ebooks   = 'what,read,downloads,link,when' | split: ','
  assign q_orders   = 'pay,safe,soon,notify,change' | split: ','
  assign q_shipping = 'cost,ebook' | split: ','
  assign q_returns  = 'send_back,ebooks,faulty' | split: ','
  assign q_contact  = 'reach,where' | split: ','

  assign withdraw_url = routes.root_url | append: '/pages/withdrawal' | replace: '//', '/'
  assign terms_url = ''
  if shop.terms_of_service.url != blank
    assign terms_url = shop.terms_of_service.url
  endif
-%}

<div class="wui-scope wui-faq wui-faq--split">
  <div class="wui-wrap">
    <h1 class="wui-heading wui-faq__title">{{ 'walterin.faq.heading' | t }}</h1>

    <div class="wui-faq__layout">
      {%- comment -%}
        The category list. A <nav> of real in-page links: they work with JavaScript off, they can
        be copied and sent, and the browser's own find-on-page still reaches the answers.
      {%- endcomment -%}
      <nav class="wui-faq__nav" aria-label="{{ 'walterin.faq.nav_label' | t | escape }}">
        <p class="wui-faq__nav-title wui-label">{{ 'walterin.faq.nav_title' | t }}</p>
        <ul class="wui-faq__nav-list list-unstyled">
          {%- for cat in cats -%}
            {%- assign cat_key = 'walterin.faq.cat.' | append: cat -%}
            <li>
              <a class="wui-faq__nav-link" href="#faq-{{ cat }}" data-wui-faq-nav>
                {{- cat_key | t -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="wui-faq__panel">
        {%- for cat in cats -%}
          {%- liquid
            assign cat_key = 'walterin.faq.cat.' | append: cat
            case cat
              when 'products'
                assign keys = q_products
              when 'ebooks'
                assign keys = q_ebooks
              when 'orders'
                assign keys = q_orders
              when 'shipping'
                assign keys = q_shipping
              when 'returns'
                assign keys = q_returns
              when 'contact'
                assign keys = q_contact
            endcase
          -%}

          <section class="wui-faq__group" id="faq-{{ cat }}" aria-labelledby="faq-{{ cat }}-h">
            <h2 class="wui-faq__group-title wui-label" id="faq-{{ cat }}-h">{{ cat_key | t }}</h2>

            <div class="wui-accordions">
              {%- for key in keys -%}
                {%- liquid
                  assign base = 'walterin.faq.q.' | append: cat | append: '_' | append: key
                  assign q_text = base | append: '.q' | t
                  assign a_text = base | append: '.a_html' | t
                  assign a_text = a_text | replace: '[WITHDRAW_URL]', withdraw_url
                  assign a_text = a_text | replace: '[TERMS_URL]', terms_url
                  assign anchor = 'q-' | append: cat | append: '-' | append: key
                -%}
                {%- unless q_text contains 'Translation missing' -%}
                  {%- comment -%}
                    <details> rather than a scripted accordion: open/close, keyboard and the
                    accessible name all come from the browser, and the answer is in the DOM for
                    find-on-page and for a search engine whether or not it is open.

                    The id is on the <details>, so /pages/faq#q-returns-faulty is a link to one
                    question. assets/walterin-faq.js opens it on arrival.
                  {%- endcomment -%}
                  <details class="wui-accordion" id="{{ anchor }}" data-wui-acc>
                    <summary>
                      <span class="wui-accordion__title">
                        {%- comment -%}
                          An <h3> inside <summary>, not a <span>. The spec allows a heading as a
                          summary's content, and it is what gives the page a real outline —
                          h1 page title, h2 category, h3 question — so a screen reader can list
                          the questions and jump between them. Of the nine shops surveyed for
                          docs/design/FAQ-RESEARCH.md, only two did this.
                        {%- endcomment -%}
                        <h3 class="wui-faq__q">{{ q_text }}</h3>
                      </span>
                      <span class="wui-accordion__icon" aria-hidden="true"></span>
                    </summary>
                    <div class="wui-accordion__wrap">
                      <div class="wui-accordion__body wui-rte">{{ a_text }}</div>
                    </div>
                  </details>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  FAQPage structured data. Built from the same locale strings as the page, so the two can never
  disagree — the usual failure is hand-written JSON-LD that keeps an answer the page has changed.

  Tags are stripped and the result JSON-escaped: acceptedAnswer.text takes text, and an unescaped
  quote in an answer would break the whole block silently.

  Only on the FAQ page itself, and only once.
{%- endcomment -%}
{%- capture faq_jsonld -%}
  {%- assign sep = '' -%}
  [
  {%- for cat in cats -%}
    {%- liquid
      case cat
        when 'products'
          assign keys = q_products
        when 'ebooks'
          assign keys = q_ebooks
        when 'orders'
          assign keys = q_orders
        when 'shipping'
          assign keys = q_shipping
        when 'returns'
          assign keys = q_returns
        when 'contact'
          assign keys = q_contact
      endcase
    -%}
    {%- for key in keys -%}
      {%- liquid
        assign base = 'walterin.faq.q.' | append: cat | append: '_' | append: key
        assign q_text = base | append: '.q' | t
        assign a_text = base | append: '.a_html' | t
        assign a_text = a_text | replace: '[WITHDRAW_URL]', withdraw_url
        assign a_text = a_text | replace: '[TERMS_URL]', terms_url
        assign a_plain = a_text | strip_html | strip | replace: '  ', ' '
      -%}
      {%- unless q_text contains 'Translation missing' -%}
        {{ sep }}{"@type":"Question","name":{{ q_text | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a_plain | json }}}}
        {%- assign sep = ',' -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endfor -%}
  ]
{%- endcapture -%}
<script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":{{ faq_jsonld }}}
</script>

<script src="{{ 'walterin-faq.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Walterin FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The questions and answers live in the theme's language files (locales/en.default.json and locales/sk.json) under walterin.faq, not in this section. That is deliberate: it keeps English and Slovak in one place, versioned together, and stops the Slovak page falling back to English. See the comment at the top of sections/walterin-faq.liquid."
    }
  ],
  "presets": [{ "name": "Walterin FAQ" }]
}
{% endschema %}
