{% comment %}
  Walterin · Look inside — the page spreads, full width, nothing around them.

  The heading and its line sit in the content frame; the images run the full width of the page with
  no frame, no shadow and nothing to click. The artwork is the point — anything drawn around it is
  in the way.

  A spread can carry a second image for phones (a taller crop); only the right one is fetched.
  Design system: assets/walterin-ui.css (body.wui). No JavaScript.
{% endcomment %}

<div class="wui-scope wui-pages">
  {%- liquid
    # The spreads and their line belong to the product, not to the page layout, so both come from
    # the product's metafields. No images, no section: a sticker set simply has nothing to look
    # inside, and the page closes up around it.
    assign wui = product.metafields.walterin
    assign spreads = wui.look_inside.value
    assign lead = wui.look_inside_note
  -%}
  {%- if spreads != blank and spreads.size > 0 -%}
    {%- if section.settings.title != blank or lead != blank -%}
      <div class="wui-wrap">
        <div class="wui-pages__head">
          {%- if section.settings.title != blank -%}
            <h2 class="wui-heading">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          {%- if lead != blank -%}
            <p class="wui-pages__lead">{{ lead | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- for file in spreads -%}
      {%- assign img = file.preview_image | default: file -%}
      {%- if img != blank -%}
        <figure class="wui-pages__item">
          <img
            src="{{ img | image_url: width: 2200 }}"
            srcset="
              {{ img | image_url: width: 750 }} 750w,
              {{ img | image_url: width: 1100 }} 1100w,
              {{ img | image_url: width: 1500 }} 1500w,
              {{ img | image_url: width: 2200 }} 2200w
            "
            sizes="100vw"
            alt="{{ img.alt | default: section.settings.title | escape }}"
            width="{{ img.width }}"
            height="{{ img.height }}"
            loading="lazy"
          >
        </figure>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>

{% stylesheet %}
.wui .wui-pages { padding-block: var(--wui-32); }
.wui .wui-pages__head { display: grid; gap: var(--wui-12); max-width: 62ch; margin-bottom: var(--wui-24); }
.wui .wui-pages__lead { font-size: var(--wui-fs-body); line-height: 1.45; margin: 0; }
.wui .wui-pages__item { margin: 0; display: grid; gap: var(--wui-8); }
.wui .wui-pages__item + .wui-pages__item { margin-top: var(--wui-24); }
.wui .wui-pages__item img { display: block; width: 100%; height: auto; }
.wui .wui-pages__cap { font-size: var(--wui-fs-small); line-height: 1.4; }
@media (min-width: 990px) {
  .wui .wui-pages { padding-block: var(--wui-48); }
  .wui .wui-pages__head { margin-bottom: var(--wui-32); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Walterin · Look inside",
  "tag": "section",
  "class": "wui-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Look inside" },
    { "type": "paragraph", "content": "The images and the line under the heading come from the product: walterin.look_inside and walterin.look_inside_note. With no images the whole section disappears." }
  ],
  "presets": [ { "name": "Walterin · Look inside" } ]
}
{% endschema %}
