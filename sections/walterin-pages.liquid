{% comment %}
  Walterin · Look inside — the page spreads, full width, nothing around them.

  The heading and its line sit in the content frame; the images run the full width of the page with
  no frame, no shadow and nothing to click. The artwork is the point — anything drawn around it is
  in the way.

  A spread can carry a second image for phones (a taller crop); only the right one is fetched.
  Design system: assets/walterin-ui.css (body.wui). No JavaScript.
{% endcomment %}

<div class="wui-scope wui-pages">
  {%- if section.settings.title != blank or section.settings.lead != blank -%}
    <div class="wui-wrap">
      <div class="wui-pages__head">
        {%- if section.settings.title != blank -%}
          <h2 class="wui-heading">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="wui-pages__lead">{{ section.settings.lead | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.settings.image != blank -%}
      <figure class="wui-pages__item" {{ block.shopify_attributes }}>
        <picture>
          {%- if block.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ block.settings.image_mobile | image_url: width: 1100 }}"
              width="{{ block.settings.image_mobile.width }}"
              height="{{ block.settings.image_mobile.height }}"
            >
          {%- endif -%}
          <img
            src="{{ block.settings.image | image_url: width: 2200 }}"
            srcset="
              {{ block.settings.image | image_url: width: 750 }} 750w,
              {{ block.settings.image | image_url: width: 1100 }} 1100w,
              {{ block.settings.image | image_url: width: 1500 }} 1500w,
              {{ block.settings.image | image_url: width: 2200 }} 2200w
            "
            sizes="100vw"
            alt="{{ block.settings.image.alt | default: section.settings.title | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
          >
        </picture>
        {%- if block.settings.caption != blank -%}
          <figcaption class="wui-wrap wui-pages__cap">{{ block.settings.caption | escape }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
.wui .wui-pages { padding-block: var(--wui-32); }
.wui .wui-pages__head { display: grid; gap: var(--wui-12); max-width: 62ch; margin-bottom: var(--wui-24); }
.wui .wui-pages__lead { font-size: var(--wui-fs-body); line-height: 1.45; margin: 0; }
.wui .wui-pages__item { margin: 0; display: grid; gap: var(--wui-8); }
.wui .wui-pages__item + .wui-pages__item { margin-top: var(--wui-24); }
.wui .wui-pages__item img { display: block; width: 100%; height: auto; }
.wui .wui-pages__cap { font-size: var(--wui-fs-small); line-height: 1.4; }
@media (min-width: 990px) {
  .wui .wui-pages { padding-block: var(--wui-48); }
  .wui .wui-pages__head { margin-bottom: var(--wui-32); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Walterin · Look inside",
  "tag": "section",
  "class": "wui-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Look inside" },
    { "type": "text", "id": "lead", "label": "Line under the heading" }
  ],
  "blocks": [
    {
      "type": "spread",
      "name": "Page",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image for phones", "info": "Optional. Used below 750px." },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Walterin · Look inside", "blocks": [ { "type": "spread" } ] } ]
}
{% endschema %}
