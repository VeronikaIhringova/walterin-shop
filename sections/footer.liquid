          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "range",
          "id": "width_desktop",
          "max": 12,
          "min": 1,
          "step": 1,
          "default": 3,
          "label": "Column desktop width"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            }
          ],
          "default": "2",
          "label": "Column mobile width"
        }
      ]
    },
    {
      "type": "image",
