{% comment %}
  "About Walterin" — a centered cream "window" that replaces the stock rich-text
  block, so it stays a cream card on the new white page (the stock rich-text used
  the background-1 scheme and would turn white with the site-wide token flip).

  Typography is unified with the rest of the page via the design-system tokens:
  - Heading: "WalterinBold", section-heading size (3.25rem mob / 4.25rem desk).
  - Body: var(--font-body-family), 1.5rem, line-height calc(1 + 0.8/scale),
    letter-spacing 0.06rem, colour var(--wlt-ink).
  Owns the .aw-* namespace only.
{% endcomment %}

{%- style -%}
  .aw-section {
    background: {{ section.settings.background | default: '#FFFEF7' }};
    padding: 52px 24px;
  }
  .aw-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .aw-heading {
    font-family: "WalterinBold", sans-serif;
    color: var(--wlt-ink, #2e2a39);
    font-size: calc(var(--font-heading-scale, 1.3) * 2.5rem);
    line-height: 1.05;
    letter-spacing: var(--wlt-h-ls, 0.4px);
    margin: 0 0 1.8rem;
  }
  @media (min-width: 750px) {
    .aw-heading { font-size: calc(var(--font-heading-scale, 1.3) * 3.25rem); }
  }
  .aw-body {
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale, 1));
    letter-spacing: 0.06rem;
    color: var(--wlt-ink, #2e2a39);
    margin: 0 auto;
  }
  .aw-body p { margin: 0 0 1.4rem; }
  .aw-body p:last-child { margin-bottom: 0; }
  .aw-body strong { font-weight: var(--font-body-weight-bold, 700); }
  .aw-body em { font-style: italic; }
  .aw-cta { margin-top: clamp(24px, 3vw, 36px); }

  @media (max-width: 749px) {
    .aw-section { padding: 40px 22px; }
  }
{%- endstyle -%}

<section class="aw-section wlt-window">
  <div class="aw-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="aw-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="aw-body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="aw-cta">
        <a href="{{ section.settings.button_link }}" class="button button--secondary wlt-btn">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Walterin",
  "tag": "section",
  "class": "section-about-walterin",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Walterin"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p><strong>Walterin</strong> is an original project by Slovak illustrator <em>Walter Ihring</em>, blending <strong>humor</strong>, <strong>history</strong>, and a <em>distinctive visual style</em>. Its mission is to reveal cities through stories that are <strong>fun</strong>, <em>truthful</em>, and <strong>inspiring</strong>.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFEF7"
    }
  ],
  "presets": [
    { "name": "About Walterin" }
  ]
}
{% endschema %}
