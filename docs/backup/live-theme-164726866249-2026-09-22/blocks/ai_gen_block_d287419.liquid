{% doc %}
  @prompt
    Create a fully customizable Shopify section called “Four Image Gallery.”
    
    The section displays 4 images side by side on desktop (clean, modern, minimal look) and becomes a 2×2 grid on mobile (two on top, two below).
    All layout, sizing, and animation options must be editable in the Shopify theme editor — no coding required.
    Images must always remain fully visible (no cropping).
    
    🧩 Preload these exact layout defaults:
    
    Desktop settings:
    
    Top padding: 50px
    
    Bottom padding: 140px
    
    Left margin: 110px
    
    Right margin: 110px
    
    Gap between images: 60px
    
    Background color: transparent
    
    Mobile settings:
    
    Enable mobile animation: true
    
    Mobile gap: 15px
    
    🖼️ Image settings (with your preset values):
    
    Image 1
    
    Width: 250px
    
    Height: 250px
    
    Top margin: 55px
    
    Bottom margin: 0px
    
    Left margin: 0px
    
    Right margin: 0px
    
    Padding: 0px
    
    Corner radius: 0px
    
    Mobile top margin: 0px
    
    Mobile bottom margin: 0px
    
    Mobile left margin: -35px
    
    Mobile right margin: 0px
    
    Mobile padding: 0px
    
    Image 2
    
    Width: 200px
    
    Height: 200px
    
    Top margin: 0px
    
    Bottom margin: 60px
    
    Left margin: 0px
    
    Right margin: 0px
    
    Padding: 0px
    
    Corner radius: 0px
    
    Mobile margins: all 0px
    
    Image 3
    
    Width: 280px
    
    Height: 280px
    
    Top margin: 90px
    
    Bottom margin: 0px
    
    Left margin: 0px
    
    Right margin: 0px
    
    Padding: 0px
    
    Corner radius: 0px
    
    Mobile margins: all 0px
    
    Image 4
    
    Width: 180px
    
    Height: 180px
    
    Top margin: 0px
    
    Bottom margin: 75px
    
    Left margin: 0px
    
    Right margin: 0px
    
    Padding: 0px
    
    Corner radius: 0px
    
    Mobile margins: all 0px, 🪄 Animations
    
    Desktop hover:
    Smooth non-cropping zoom:
    
    transform: scale(1.05);
    object-fit: contain;
    overflow: visible;
    transition: transform 0.4s ease-in-out;
    
    
    Mobile sequential zoom:
    Looping one-by-one zoom animation:
    
    @keyframes slowZoom {
      0%,100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .image-block:nth-child(1) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 0s; }
    .image-block:nth-child(2) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 1s; }
    .image-block:nth-child(3) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 2s; }
    .image-block:nth-child(4) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 3s; }
    
    ⚙️ Technical requirements
    
    Default image container: 200×200px (desktop) / 250×250px (mobile)
    
    Use CSS Grid or Flexbox
    
    Enable lazy loading and alt text
    
    Clean, minimal, fully responsive design
    
    All parameters (sizes, margins, padding, colors) visible in Shopify theme editor
    
    Section name: Four Image Gallery
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-image-gallery-{{ ai_gen_id }} {
    padding-top: {{ block.settings.desktop_padding_top }}px;
    padding-bottom: {{ block.settings.desktop_padding_bottom }}px;
    margin-left: {{ block.settings.desktop_margin_left }}px;
    margin-right: {{ block.settings.desktop_margin_right }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-four-image-gallery__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.desktop_gap }}px;
  }

  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    overflow: visible;
  }

  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease-in-out;
  }

  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-four-image-gallery__image-1-{{ ai_gen_id }} {
    width: {{ block.settings.image_1_width }}px;
    height: {{ block.settings.image_1_height }}px;
    margin-top: {{ block.settings.image_1_margin_top }}px;
    margin-bottom: {{ block.settings.image_1_margin_bottom }}px;
    margin-left: {{ block.settings.image_1_margin_left }}px;
    margin-right: {{ block.settings.image_1_margin_right }}px;
    padding: {{ block.settings.image_1_padding }}px;
    border-radius: {{ block.settings.image_1_radius }}px;
  }

  .ai-four-image-gallery__image-2-{{ ai_gen_id }} {
    width: {{ block.settings.image_2_width }}px;
    height: {{ block.settings.image_2_height }}px;
    margin-top: {{ block.settings.image_2_margin_top }}px;
    margin-bottom: {{ block.settings.image_2_margin_bottom }}px;
    margin-left: {{ block.settings.image_2_margin_left }}px;
    margin-right: {{ block.settings.image_2_margin_right }}px;
    padding: {{ block.settings.image_2_padding }}px;
    border-radius: {{ block.settings.image_2_radius }}px;
  }

  .ai-four-image-gallery__image-3-{{ ai_gen_id }} {
    width: {{ block.settings.image_3_width }}px;
    height: {{ block.settings.image_3_height }}px;
    margin-top: {{ block.settings.image_3_margin_top }}px;
    margin-bottom: {{ block.settings.image_3_margin_bottom }}px;
    margin-left: {{ block.settings.image_3_margin_left }}px;
    margin-right: {{ block.settings.image_3_margin_right }}px;
    padding: {{ block.settings.image_3_padding }}px;
    border-radius: {{ block.settings.image_3_radius }}px;
  }

  .ai-four-image-gallery__image-4-{{ ai_gen_id }} {
    width: {{ block.settings.image_4_width }}px;
    height: {{ block.settings.image_4_height }}px;
    margin-top: {{ block.settings.image_4_margin_top }}px;
    margin-bottom: {{ block.settings.image_4_margin_bottom }}px;
    margin-left: {{ block.settings.image_4_margin_left }}px;
    margin-right: {{ block.settings.image_4_margin_right }}px;
    padding: {{ block.settings.image_4_padding }}px;
    border-radius: {{ block.settings.image_4_radius }}px;
  }

  .ai-four-image-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-image-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .ai-four-image-gallery-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      margin-left: {{ block.settings.mobile_margin_left }}px;
      margin-right: {{ block.settings.mobile_margin_right }}px;
    }

    .ai-four-image-gallery__container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:hover img {
      transform: none;
    }

    .ai-four-image-gallery__image-1-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
      margin-top: {{ block.settings.image_1_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_1_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_1_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_1_mobile_margin_right }}px;
      padding: {{ block.settings.image_1_mobile_padding }}px;
    }

    .ai-four-image-gallery__image-2-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
      margin-top: {{ block.settings.image_2_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_2_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_2_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_2_mobile_margin_right }}px;
      padding: {{ block.settings.image_2_mobile_padding }}px;
    }

    .ai-four-image-gallery__image-3-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
      margin-top: {{ block.settings.image_3_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_3_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_3_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_3_mobile_margin_right }}px;
      padding: {{ block.settings.image_3_mobile_padding }}px;
    }

    .ai-four-image-gallery__image-4-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
      margin-top: {{ block.settings.image_4_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_4_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_4_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_4_mobile_margin_right }}px;
      padding: {{ block.settings.image_4_mobile_padding }}px;
    }

    {% if block.settings.enable_mobile_animation %}
      @keyframes ai-slow-zoom-{{ ai_gen_id }} {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:nth-child(1) img {
        animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
        animation-delay: 0s;
      }

      .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:nth-child(2) img {
        animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
        animation-delay: 1s;
      }

      .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:nth-child(3) img {
        animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
        animation-delay: 2s;
      }

      .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:nth-child(4) img {
        animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
        animation-delay: 3s;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-four-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-image-gallery__container-{{ ai_gen_id }}">
    <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} ai-four-image-gallery__image-1-{{ ai_gen_id }}">
      {% if block.settings.image_1 %}
        <img
          src="{{ block.settings.image_1 | image_url: width: 1000 }}"
          alt="{{ block.settings.image_1.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_1.width }}"
          height="{{ block.settings.image_1.height }}"
        >
      {% else %}
        <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} ai-four-image-gallery__image-2-{{ ai_gen_id }}">
      {% if block.settings.image_2 %}
        <img
          src="{{ block.settings.image_2 | image_url: width: 1000 }}"
          alt="{{ block.settings.image_2.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_2.width }}"
          height="{{ block.settings.image_2.height }}"
        >
      {% else %}
        <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} ai-four-image-gallery__image-3-{{ ai_gen_id }}">
      {% if block.settings.image_3 %}
        <img
          src="{{ block.settings.image_3 | image_url: width: 1000 }}"
          alt="{{ block.settings.image_3.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_3.width }}"
          height="{{ block.settings.image_3.height }}"
        >
      {% else %}
        <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} ai-four-image-gallery__image-4-{{ ai_gen_id }}">
      {% if block.settings.image_4 %}
        <img
          src="{{ block.settings.image_4 | image_url: width: 1000 }}"
          alt="{{ block.settings.image_4.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_4.width }}"
          height="{{ block.settings.image_4.height }}"
        >
      {% else %}
        <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

