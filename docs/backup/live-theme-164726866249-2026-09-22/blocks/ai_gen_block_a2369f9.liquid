{% doc %}
  @prompt
    a single section that will take any HTML. the section is only to house custom CSS code, so no height or width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-html-{{ ai_gen_id }} {
    display: block;
  }

  {{ block.settings.custom_css }}
{% endstyle %}

<div class="ai-custom-html-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {{ block.settings.custom_html }}
</div>

{% schema %}
{
  "name": "Custom HTML & CSS",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "HTML"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML"
    },
    {
      "type": "header",
      "content": "CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "Custom HTML & CSS"
    }
  ]
}
{% endschema %}
