{% doc %}
  @prompt
    Create a Shopify section called “Four Image Gallery.”
    
    The section displays 4 images in one row on desktop (clean, minimal look) and becomes a 2×2 grid on mobile (two on top, two on bottom).
    
    🖼️ Individual Image Controls
    
    Each image must be editable in the theme editor with:
    
    Upload image
    
    Width & height (default 200×200px, adjustable)
    
    Margins (top, bottom, left, right: –200px to +200px)
    
    Padding (0–100px)
    
    Gap to next image (–100px to +100px)
    
    Corner radius (0–50px)
    
    Optional clickable link
    
    🧭 Section-Wide Controls
    
    Top & bottom padding (0–200px)
    
    Left & right margins (–200px to +200px)
    
    Global gap (–100px to +100px)
    
    Optional heading, subheading & background color
    
    Text color control
    
    🖥️ Desktop Behavior
    
    All 4 images in a single row using Flex/Grid
    
    Images never crop — always fully visible
    
    Smooth hover zoom:
    
    transform: scale(1.05);
    object-fit: contain;
    transition: transform 0.4s ease-in-out;
    
    
    Elegant focus effect on hover, no overset, Make the section fully adaptable for mobile (max-width: 768px).
    
    Layout: 2×2 grid (two top, two bottom)
    
    Independent mobile settings (not linked to desktop):
    
    Mobile width & height (default 250×250px, adjustable)
    
    Mobile margins (top, bottom, left, right: –200px to +200px)
    
    Mobile padding (0–100px)
    
    Full flexibility to move images anywhere — up, down, left, right
    
    Always show full image, no cropping
    
    🎞️ Mobile Sequential Zoom Animation
    
    Since hover doesn’t exist on mobile, use an automatic looping animation:
    
    Order: top-left → top-right → bottom-left → bottom-right
    
    Each image zooms (scale(1.05)) for 1s, then returns
    
    Delay between each: 0.3–0.5s
    
    Pause 3s before restarting loop
    
    CSS example:
    
    @keyframes slowZoom {
      0%,100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .image-block:nth-child(1) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 0s; }
    .image-block:nth-child(2) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 1s; }
    .image-block:nth-child(3) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 2s; }
    .image-block:nth-child(4) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 3s; }
    
    
    Subtle, calm “living gallery” feeling
    
    Animation stops naturally when user scrolls or taps
    
    Mobile section must be fully editable directly in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-image-gallery-{{ ai_gen_id }} {
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    margin-left: {{ block.settings.section_margin_left }}px;
    margin-right: {{ block.settings.section_margin_right }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-four-image-gallery__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-four-image-gallery__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    font-size: 32px;
    font-weight: 500;
  }

  .ai-four-image-gallery__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: 16px;
    opacity: 0.8;
  }

  .ai-four-image-gallery__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.global_gap }}px;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
  }

  .ai-four-image-gallery__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-four-image-gallery__link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-image-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.4s ease-in-out;
  }

  .ai-four-image-gallery__link-{{ ai_gen_id }}:hover .ai-four-image-gallery__image-{{ ai_gen_id }},
  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:hover .ai-four-image-gallery__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-four-image-gallery__link-{{ ai_gen_id }}:focus,
  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  .ai-four-image-gallery__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-image-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 768px) {
    .ai-four-image-gallery-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_section_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_section_padding_bottom }}px;
      margin-left: {{ block.settings.mobile_section_margin_left }}px;
      margin-right: {{ block.settings.mobile_section_margin_right }}px;
    }

    .ai-four-image-gallery__container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ block.settings.mobile_global_gap }}px;
    }

    .ai-four-image-gallery__heading-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-four-image-gallery__subheading-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-four-image-gallery__link-{{ ai_gen_id }}:hover .ai-four-image-gallery__image-{{ ai_gen_id }},
    .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}:hover .ai-four-image-gallery__image-{{ ai_gen_id }} {
      transform: scale(1);
    }

    @keyframes ai-slow-zoom-{{ ai_gen_id }} {
      0%, 100% {
        transform: scale(1);
      }
      12.5% {
        transform: scale(1.05);
      }
      25% {
        transform: scale(1);
      }
    }

    .ai-four-image-gallery__item-{{ ai_gen_id }}:nth-child(1) .ai-four-image-gallery__image-{{ ai_gen_id }} {
      animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 0s;
    }

    .ai-four-image-gallery__item-{{ ai_gen_id }}:nth-child(2) .ai-four-image-gallery__image-{{ ai_gen_id }} {
      animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 1s;
    }

    .ai-four-image-gallery__item-{{ ai_gen_id }}:nth-child(3) .ai-four-image-gallery__image-{{ ai_gen_id }} {
      animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 2s;
    }

    .ai-four-image-gallery__item-{{ ai_gen_id }}:nth-child(4) .ai-four-image-gallery__image-{{ ai_gen_id }} {
      animation: ai-slow-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 3s;
    }
  }
{% endstyle %}

<div class="ai-four-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-four-image-gallery__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-four-image-gallery__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-four-image-gallery__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-four-image-gallery__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign width_key = 'image_' | append: i | append: '_width'
        assign height_key = 'image_' | append: i | append: '_height'
        assign margin_top_key = 'image_' | append: i | append: '_margin_top'
        assign margin_bottom_key = 'image_' | append: i | append: '_margin_bottom'
        assign margin_left_key = 'image_' | append: i | append: '_margin_left'
        assign margin_right_key = 'image_' | append: i | append: '_margin_right'
        assign padding_key = 'image_' | append: i | append: '_padding'
        assign gap_key = 'image_' | append: i | append: '_gap'
        assign radius_key = 'image_' | append: i | append: '_radius'
        assign link_key = 'image_' | append: i | append: '_link'

        assign mobile_width_key = 'mobile_image_' | append: i | append: '_width'
        assign mobile_height_key = 'mobile_image_' | append: i | append: '_height'
        assign mobile_margin_top_key = 'mobile_image_' | append: i | append: '_margin_top'
        assign mobile_margin_bottom_key = 'mobile_image_' | append: i | append: '_margin_bottom'
        assign mobile_margin_left_key = 'mobile_image_' | append: i | append: '_margin_left'
        assign mobile_margin_right_key = 'mobile_image_' | append: i | append: '_margin_right'
        assign mobile_padding_key = 'mobile_image_' | append: i | append: '_padding'
        assign mobile_radius_key = 'mobile_image_' | append: i | append: '_radius'

        assign image = block.settings[image_key]
        assign width = block.settings[width_key]
        assign height = block.settings[height_key]
        assign margin_top = block.settings[margin_top_key]
        assign margin_bottom = block.settings[margin_bottom_key]
        assign margin_left = block.settings[margin_left_key]
        assign margin_right = block.settings[margin_right_key]
        assign padding = block.settings[padding_key]
        assign gap = block.settings[gap_key]
        assign radius = block.settings[radius_key]
        assign link = block.settings[link_key]

        assign mobile_width = block.settings[mobile_width_key]
        assign mobile_height = block.settings[mobile_height_key]
        assign mobile_margin_top = block.settings[mobile_margin_top_key]
        assign mobile_margin_bottom = block.settings[mobile_margin_bottom_key]
        assign mobile_margin_left = block.settings[mobile_margin_left_key]
        assign mobile_margin_right = block.settings[mobile_margin_right_key]
        assign mobile_padding = block.settings[mobile_padding_key]
        assign mobile_radius = block.settings[mobile_radius_key]
      %}

      <style>
        .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} {
          margin-top: {{ margin_top }}px;
          margin-bottom: {{ margin_bottom }}px;
          margin-left: {{ margin_left }}px;
          margin-right: {{ margin_right }}px;
          padding: {{ padding }}px;
          {% if i < 4 %}margin-right: calc({{ margin_right }}px + {{ gap }}px);{% endif %}
        }

        .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} {
          width: {{ width }}px;
          height: {{ height }}px;
          border-radius: {{ radius }}px;
        }

        .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} .ai-four-image-gallery__image-{{ ai_gen_id }},
        .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} .ai-four-image-gallery__placeholder-{{ ai_gen_id }} {
          border-radius: {{ radius }}px;
        }

        @media screen and (max-width: 768px) {
          .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} {
            margin-top: {{ mobile_margin_top }}px;
            margin-bottom: {{ mobile_margin_bottom }}px;
            margin-left: {{ mobile_margin_left }}px;
            margin-right: {{ mobile_margin_right }}px;
            padding: {{ mobile_padding }}px;
          }

          .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} {
            width: {{ mobile_width }}px;
            height: {{ mobile_height }}px;
            border-radius: {{ mobile_radius }}px;
          }

          .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} .ai-four-image-gallery__image-{{ ai_gen_id }},
          .ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }} .ai-four-image-gallery__placeholder-{{ ai_gen_id }} {
            border-radius: {{ mobile_radius }}px;
          }
        }
      </style>

      <div class="ai-four-image-gallery__item-{{ ai_gen_id }} ai-four-image-gallery__item-{{ ai_gen_id }}-{{ i }}">
        {% if link != blank %}
          <a
            href="{{ link }}"
            class="ai-four-image-gallery__link-{{ ai_gen_id }}"
            aria-label="View image {{ i }}"
          >
            <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ width }}"
                  height="{{ height }}"
                  class="ai-four-image-gallery__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </a>
        {% else %}
          <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }}" tabindex="0">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ width }}"
                height="{{ height }}"
                class="ai-four-image-gallery__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

