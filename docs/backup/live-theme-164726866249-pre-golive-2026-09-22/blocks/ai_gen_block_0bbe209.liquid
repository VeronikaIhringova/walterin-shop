{% doc %}
  @prompt
    Create a fully customizable Shopify section called “Four Image Gallery.”
    
    This section should display 4 images side by side (1 row) on desktop, 2 × 2 grid on tablet, and stacked vertically on mobile.
    The design must always keep all images fully visible (no cropping) while allowing complete flexibility in spacing and positioning.
    
    🖼️ Individual image settings
    
    Each image must be individually editable in the Shopify theme editor with these adjustable options:
    
    Upload image
    
    Image width and height: adjustable, default 200 px × 200 px, maintaining aspect ratio
    
    Left and right margins: adjustable range from –200 px to 200 px (allows overlap or extra spacing)
    
    Top and bottom margins: adjustable range from –200 px to 200 px (to move the image up or down freely)
    
    Padding: adjustable range 0–100 px
    
    Distance (gap) between images: adjustable range –100 px to 100 px for full control (allows images to touch or overlap)
    
    Corner radius: adjustable range 0–50 px
    
    Optional link so each image can be clickable
    
    🧩 Section-wide controls
    
    Global top and bottom padding (range 0–200 px)
    
    Global left and right margins (range –200 px to 200 px)
    
    Global gap control between all images (range –100 px to 100 px)
    
    Optional background color selector
    
    Optional section heading and subheading above the image row
    
    🪄 Hover animation (non-cropping zoom effect)
    
    On hover, each image should simulate a zoom without cropping or hiding any edges.
    
    Use:
    
    transform: scale(1.05) translateZ(0);
    object-fit: contain;
    overflow: visible;
    transition: transform 0.4s ease-in-out;
    
    
    The entire image must remain fully visible at all times — no clipping, overset, or hidden edges.
    
    The zoom should feel natural and subtle, creating a focus/attention effect.
    
    ⚙️ Technical & design requirements
    
    Default image container: 200 × 200 px (adjustable)
    
    Never crop or hide images; always show full content within frame
    
    Use flexbox or CSS grid for layout
    
    Lazy loading for performance
    
    Alt text support for accessibility
    
    Clean, min
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-image-gallery-{{ ai_gen_id }} {
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    margin-left: {{ block.settings.section_margin_left }}px;
    margin-right: {{ block.settings.section_margin_right }}px;
    {% if block.settings.background_color != blank %}
      background-color: {{ block.settings.background_color }};
    {% endif %}
  }

  .ai-four-image-gallery__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-four-image-gallery__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-four-image-gallery__heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-size: 32px;
    color: {{ settings.colors_text }};
  }

  .ai-four-image-gallery__subheading-{{ ai_gen_id }} {
    margin: 0;
    font-size: 16px;
    color: {{ settings.colors_text }};
    opacity: 0.8;
  }

  .ai-four-image-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.global_gap }}px;
    align-items: center;
    justify-items: center;
  }

  .ai-four-image-gallery__item-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-four-image-gallery__link-{{ ai_gen_id }} {
    display: block;
    overflow: visible;
    position: relative;
  }

  .ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} {
    overflow: visible;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-image-gallery__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease-in-out;
    will-change: transform;
  }

  .ai-four-image-gallery__link-{{ ai_gen_id }}:hover .ai-four-image-gallery__image-{{ ai_gen_id }} {
    transform: scale(1.05) translateZ(0);
  }

  .ai-four-image-gallery__image-1-{{ ai_gen_id }} {
    width: {{ block.settings.image_1_width }}px;
    height: {{ block.settings.image_1_height }}px;
    margin-top: {{ block.settings.image_1_margin_top }}px;
    margin-bottom: {{ block.settings.image_1_margin_bottom }}px;
    margin-left: {{ block.settings.image_1_margin_left }}px;
    margin-right: {{ block.settings.image_1_margin_right }}px;
    padding: {{ block.settings.image_1_padding }}px;
    border-radius: {{ block.settings.image_1_radius }}px;
  }

  .ai-four-image-gallery__image-2-{{ ai_gen_id }} {
    width: {{ block.settings.image_2_width }}px;
    height: {{ block.settings.image_2_height }}px;
    margin-top: {{ block.settings.image_2_margin_top }}px;
    margin-bottom: {{ block.settings.image_2_margin_bottom }}px;
    margin-left: {{ block.settings.image_2_margin_left }}px;
    margin-right: {{ block.settings.image_2_margin_right }}px;
    padding: {{ block.settings.image_2_padding }}px;
    border-radius: {{ block.settings.image_2_radius }}px;
  }

  .ai-four-image-gallery__image-3-{{ ai_gen_id }} {
    width: {{ block.settings.image_3_width }}px;
    height: {{ block.settings.image_3_height }}px;
    margin-top: {{ block.settings.image_3_margin_top }}px;
    margin-bottom: {{ block.settings.image_3_margin_bottom }}px;
    margin-left: {{ block.settings.image_3_margin_left }}px;
    margin-right: {{ block.settings.image_3_margin_right }}px;
    padding: {{ block.settings.image_3_padding }}px;
    border-radius: {{ block.settings.image_3_radius }}px;
  }

  .ai-four-image-gallery__image-4-{{ ai_gen_id }} {
    width: {{ block.settings.image_4_width }}px;
    height: {{ block.settings.image_4_height }}px;
    margin-top: {{ block.settings.image_4_margin_top }}px;
    margin-bottom: {{ block.settings.image_4_margin_bottom }}px;
    margin-left: {{ block.settings.image_4_margin_left }}px;
    margin-right: {{ block.settings.image_4_margin_right }}px;
    padding: {{ block.settings.image_4_padding }}px;
    border-radius: {{ block.settings.image_4_radius }}px;
  }

  .ai-four-image-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: inherit;
  }

  .ai-four-image-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .ai-four-image-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-image-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-four-image-gallery__heading-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-four-image-gallery__subheading-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-four-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-image-gallery__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-four-image-gallery__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-four-image-gallery__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-four-image-gallery__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-four-image-gallery__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign link_key = 'image_' | append: i | append: '_link'
          assign image = block.settings[image_key]
          assign link = block.settings[link_key]
        %}

        <div class="ai-four-image-gallery__item-{{ ai_gen_id }}">
          {% if link != blank %}
            <a href="{{ link }}" class="ai-four-image-gallery__link-{{ ai_gen_id }}">
              <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} ai-four-image-gallery__image-{{ i }}-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    alt="{{ image.alt | escape }}"
                    class="ai-four-image-gallery__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                {% else %}
                  <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </a>
          {% else %}
            <div class="ai-four-image-gallery__link-{{ ai_gen_id }}">
              <div class="ai-four-image-gallery__image-wrapper-{{ ai_gen_id }} ai-four-image-gallery__image-{{ i }}-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    alt="{{ image.alt | escape }}"
                    class="ai-four-image-gallery__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                {% else %}
                  <div class="ai-four-image-gallery__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

