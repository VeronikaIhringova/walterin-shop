{% doc %}
  @prompt
    3 columns of text, headline and body text, in phone make it under each other, but not too big, like smaller, and eleant, make it editable for me, customisable, the distances and width height, the text sizes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-columns-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-columns__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-three-columns__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-three-columns__column-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-three-columns__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-three-columns__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-three-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-three-columns__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-three-columns__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-three-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-columns__container-{{ ai_gen_id }}">
    <div class="ai-three-columns__grid-{{ ai_gen_id }}">
      <div class="ai-three-columns__column-{{ ai_gen_id }}">
        {% if block.settings.heading_1 != blank %}
          <h3 class="ai-three-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
        {% endif %}
        {% if block.settings.text_1 != blank %}
          <div class="ai-three-columns__text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
        {% endif %}
      </div>

      <div class="ai-three-columns__column-{{ ai_gen_id }}">
        {% if block.settings.heading_2 != blank %}
          <h3 class="ai-three-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <div class="ai-three-columns__text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
        {% endif %}
      </div>

      <div class="ai-three-columns__column-{{ ai_gen_id }}">
        {% if block.settings.heading_3 != blank %}
          <h3 class="ai-three-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_3 }}</h3>
        {% endif %}
        {% if block.settings.text_3 != blank %}
          <div class="ai-three-columns__text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

