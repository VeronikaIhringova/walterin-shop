{% doc %}
  @prompt
    Create a modern, minimalistic 3-section layout with alternating content blocks.
    Each section should have text on one side and an image on the other, switching sides with every section (left-right-left).
    The design should feel editorial and creative, with clean typography, flexible spacing, and lots of room for customization.
    Include editable options for:
    Headings, subheadings, and paragraph text with adjustable font sizes, colors, and spacing
    Image uploads and the ability to adjust image size, corner radius, and alignment
    Section background color, padding, and gap between sections
    Option to reorder or hide individual sections
    Button text and link for each section
    The layout should feel visually balanced and responsive, with smooth transitions on hover.
    Make sure I can easily move text and image positions, experiment with spacing, and create unique compositions for each block.
    Use a neutral background, subtle animations, and spacing that feels airy and modern — like a creative brand or design portfolio page., Create a fully customizable 3-section layout that alternates image and text (left-right-left).
    The design should look premium, creative, and editorial — with clean typography, minimal lines, and an airy layout.
    Each section must have:
    Editable headings, subheadings, body text, and buttons, with adjustable font size, color, spacing, and alignment (left, center, right).
    Editable images, with controls for width, height, border radius, shadows, filters (blur, grayscale, brightness), and hover effects (scale, opacity, rotation, or subtle parallax).
    Editable layout spacing (padding, margin, and gap between text and image) so I can freely control proportions and visual rhythm.
    Editable section background (color, gradient, or image), section height, and content width (e.g., full-width or contained).
    Add advanced customization options:
    Adjustable layout direction for each section (switch text/image sides manually).
    Adjustable text box width and position (drag or control with sliders).
    Option to apply scroll or fade animations for each section (text fade-in, image slide-in, etc.).
    Controls for image effects on hover (slight zoom, brightness shift, color overlay, or tilt).
    Option to toggle dividers or separators between sections (solid, dotted, gradient line).
    Add responsive breakpoints for mobile, tablet, and desktop, allowing separate size and spacing settings for each.
    Make everything editable directly in the Shopify theme editor (no code edits required).
    Each visual and text element should have its own setting in the sidebar so I can experiment with layout, typography, colors, and effects easily.
    The overall aesthetic should be smooth, modern, and modular — like a creative studio or portfolio site.
    Include soft transitions, layered depth, and balance between white space and content density.
    Let me freely play with composition and scale, making the section feel handcrafted and personal., Add developer-style controls for advanced editing:
    Custom CSS variables or “advanced mode” where I can fine-tune element width, height, z-index, opacity, and animation speed directly in the editor.
    The layout must feel clean and intelligent, not boxed or templated:
    No image shadows, frames, or background cards.
    Images should appear integrated into the layout — full-bleed or partially overlapping text areas.
    Avoid white rectangles or containers around images; everything should look natural, continuous, and editorial.
    Allow the image to behave like a background or layered element with optional parallax or depth effects.
    Keep spacing open, with elegant typography and precise visual balance.
    The overall aesthetic should be simple yet smart, with seamless flow, responsive adaptability, and creative flexibility.
    Let me easily move, resize, and reposition text and images to experiment with layout rhythm and design compositions that feel handcrafted and distinct.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-advanced-editorial-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    background-image: {% if block.settings.background_image %}url('{{ block.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    background-size: cover;
    background-position: center;
    background-attachment: {% if block.settings.background_parallax %}fixed{% else %}scroll{% endif %};
    padding: {{ block.settings.section_padding_desktop }}px 0;
    min-height: {{ block.settings.section_min_height }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-advanced-editorial__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-advanced-editorial__sections-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.section_gap }}px;
  }

  .ai-advanced-editorial__divider-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.divider_thickness }}px;
    background: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px 0;
    opacity: {{ block.settings.divider_opacity | divided_by: 100.0 }};
    {% if block.settings.divider_style == 'dotted' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.divider_color }} 0px,
        {{ block.settings.divider_color }} 10px,
        transparent 10px,
        transparent 20px
      );
    {% elsif block.settings.divider_style == 'gradient' %}
      background: linear-gradient(
        to right,
        transparent,
        {{ block.settings.divider_color }},
        transparent
      );
    {% endif %}
  }

  .ai-advanced-editorial__section-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.text_column_width }}% {{ 100 | minus: block.settings.text_column_width }}%;
    gap: {{ block.settings.content_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    position: relative;
    opacity: 0;
    transform: translateY({{ block.settings.animation_distance }}px);
    transition: opacity {{ block.settings.animation_duration }}s {{ block.settings.animation_easing }}, transform {{ block.settings.animation_duration }}s {{ block.settings.animation_easing }};
  }

  .ai-advanced-editorial__section-{{ ai_gen_id }}.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-advanced-editorial__section-{{ ai_gen_id }}.reverse {
    direction: rtl;
  }

  .ai-advanced-editorial__section-{{ ai_gen_id }}.reverse > * {
    direction: ltr;
  }

  .ai-advanced-editorial__content-{{ ai_gen_id }} {
    padding: {{ block.settings.text_box_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
    z-index: {{ block.settings.text_z_index }};
    opacity: {{ block.settings.text_opacity | divided_by: 100.0 }};
    width: {{ block.settings.text_box_width }}%;
    margin-left: {% if block.settings.text_alignment == 'center' %}auto{% elsif block.settings.text_alignment == 'right' %}auto{% else %}{{ block.settings.text_box_offset }}px{% endif %};
    margin-right: {% if block.settings.text_alignment == 'center' %}auto{% elsif block.settings.text_alignment == 'left' %}auto{% else %}{{ block.settings.text_box_offset }}px{% endif %};
  }

  .ai-advanced-editorial__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: {{ block.settings.subheading_weight }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    text-transform: {% if block.settings.subheading_uppercase %}uppercase{% else %}none{% endif %};
    line-height: {{ block.settings.subheading_line_height }};
    opacity: {{ block.settings.subheading_opacity | divided_by: 100.0 }};
  }

  .ai-advanced-editorial__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
    opacity: {{ block.settings.heading_opacity | divided_by: 100.0 }};
  }

  .ai-advanced-editorial__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.text_line_height }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
    opacity: {{ block.settings.body_text_opacity | divided_by: 100.0 }};
  }

  .ai-advanced-editorial__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all {{ block.settings.button_transition_duration }}s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    opacity: {{ block.settings.button_opacity | divided_by: 100.0 }};
  }

  .ai-advanced-editorial__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY({{ block.settings.button_hover_lift }}px);
    opacity: {{ block.settings.button_hover_opacity | divided_by: 100.0 }};
  }

  .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: {% if block.settings.image_overflow %}visible{% else %}hidden{% endif %};
    border-radius: {{ block.settings.image_radius }}px;
    width: {{ block.settings.image_width }}%;
    height: {{ block.settings.image_height }}px;
    margin: 0 auto;
    z-index: {{ block.settings.image_z_index }};
    transform: translateX({{ block.settings.image_offset_x }}px) translateY({{ block.settings.image_offset_y }}px);
  }

  .ai-advanced-editorial__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_object_fit }};
    display: block;
    transition: transform {{ block.settings.image_hover_duration }}s ease, filter {{ block.settings.image_hover_duration }}s ease, opacity {{ block.settings.image_hover_duration }}s ease;
    filter: blur({{ block.settings.image_blur }}px) grayscale({{ block.settings.image_grayscale }}%) brightness({{ block.settings.image_brightness }}%);
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
  }

  {% if block.settings.image_hover_effect == 'zoom' %}
    .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }}:hover .ai-advanced-editorial__image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.image_hover_scale }});
    }
  {% elsif block.settings.image_hover_effect == 'brightness' %}
    .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }}:hover .ai-advanced-editorial__image-{{ ai_gen_id }} {
      filter: blur({{ block.settings.image_blur }}px) grayscale({{ block.settings.image_grayscale }}%) brightness({{ block.settings.image_hover_brightness }}%);
    }
  {% elsif block.settings.image_hover_effect == 'opacity' %}
    .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }}:hover .ai-advanced-editorial__image-{{ ai_gen_id }} {
      opacity: {{ block.settings.image_hover_opacity | divided_by: 100.0 }};
    }
  {% elsif block.settings.image_hover_effect == 'tilt' %}
    .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }}:hover .ai-advanced-editorial__image-{{ ai_gen_id }} {
      transform: rotate({{ block.settings.image_hover_rotation }}deg) scale(1.05);
    }
  {% endif %}

  .ai-advanced-editorial__image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.image_overlay_color }};
    opacity: 0;
    transition: opacity {{ block.settings.image_hover_duration }}s ease;
    pointer-events: none;
    z-index: {{ block.settings.overlay_z_index }};
  }

  .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }}:hover .ai-advanced-editorial__image-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  .ai-advanced-editorial__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-advanced-editorial__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  {% if block.settings.enable_parallax %}
    .ai-advanced-editorial__parallax-{{ ai_gen_id }} {
      transform: translateY(calc(var(--scroll-offset) * {{ block.settings.parallax_speed }}px));
      transition: transform 0.1s linear;
    }
  {% endif %}

  @media screen and (max-width: 1024px) {
    .ai-advanced-editorial-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_tablet }}px 0;
    }

    .ai-advanced-editorial__section-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.content_gap_tablet }}px;
    }

    .ai-advanced-editorial__section-{{ ai_gen_id }}.reverse {
      direction: ltr;
    }

    .ai-advanced-editorial__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * {{ block.settings.heading_scale_tablet | divided_by: 100.0 }});
    }

    .ai-advanced-editorial__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * {{ block.settings.subheading_scale_tablet | divided_by: 100.0 }});
    }

    .ai-advanced-editorial__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * {{ block.settings.text_scale_tablet | divided_by: 100.0 }});
    }

    .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_tablet }}%;
      height: {{ block.settings.image_height_tablet }}px;
    }

    .ai-advanced-editorial__content-{{ ai_gen_id }} {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-advanced-editorial-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 0;
    }

    .ai-advanced-editorial__section-{{ ai_gen_id }} {
      gap: {{ block.settings.content_gap_mobile }}px;
    }

    .ai-advanced-editorial__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * {{ block.settings.heading_scale_mobile | divided_by: 100.0 }});
    }

    .ai-advanced-editorial__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * {{ block.settings.subheading_scale_mobile | divided_by: 100.0 }});
    }

    .ai-advanced-editorial__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * {{ block.settings.text_scale_mobile | divided_by: 100.0 }});
    }

    .ai-advanced-editorial__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}%;
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-advanced-editorial__content-{{ ai_gen_id }} {
      padding: {{ block.settings.text_box_padding_mobile }}px;
    }
  }
{% endstyle %}

<advanced-editorial-{{ ai_gen_id }} class="ai-advanced-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-advanced-editorial__container-{{ ai_gen_id }}">
    <div class="ai-advanced-editorial__sections-{{ ai_gen_id }}">
      {% if block.settings.section_1_enabled %}
        <div class="ai-advanced-editorial__section-{{ ai_gen_id }} {% if block.settings.section_1_reverse %}reverse{% endif %}" data-section="1">
          <div class="ai-advanced-editorial__content-{{ ai_gen_id }}">
            {% if block.settings.section_1_subheading != blank %}
              <div class="ai-advanced-editorial__subheading-{{ ai_gen_id }}">
                {{ block.settings.section_1_subheading }}
              </div>
            {% endif %}
            {% if block.settings.section_1_heading != blank %}
              <h2 class="ai-advanced-editorial__heading-{{ ai_gen_id }}">
                {{ block.settings.section_1_heading }}
              </h2>
            {% endif %}
            {% if block.settings.section_1_text != blank %}
              <div class="ai-advanced-editorial__text-{{ ai_gen_id }}">
                {{ block.settings.section_1_text }}
              </div>
            {% endif %}
            {% if block.settings.section_1_button_text != blank %}
              <a href="{{ block.settings.section_1_button_link }}" class="ai-advanced-editorial__button-{{ ai_gen_id }}">
                {{ block.settings.section_1_button_text }}
              </a>
            {% endif %}
          </div>
          <div class="ai-advanced-editorial__image-wrapper-{{ ai_gen_id }} {% if block.settings.enable_parallax %}ai-advanced-editorial__parallax-{{ ai_gen_id }}{% endif %}">
            {% if block.settings.section_1_image %}
              <img
                src="{{ block.settings.section_1_image | image_url: width: 1600 }}"
                alt="{{ block.settings.section_1_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.section_1_image.width }}"
                height="{{ block.settings.section_1_image.height }}"
                class="ai-advanced-editorial__image-{{ ai_gen_id }}"
              >
              <div class="ai-advanced-editorial__image-overlay-{{ ai_gen_id }}"></div>
            {% else %}
              <div class="ai-advanced-editorial__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>

        {% if block.settings.show_divider and block.settings.section_2_enabled %}
          <div class="ai-advanced-editorial__divider-{{ ai_gen_id }}"></div>
        {% endif %}
      {% endif %}

      {% if block.settings.section_2_enabled %}
        <div class="ai-advanced-editorial__section-{{ ai_gen_id }} {% if block.settings.section_2_reverse %}reverse{% endif %}" data-section="2">
          <div class="ai-advanced-editorial__content-{{ ai_gen_id }}">
            {% if block.settings.section_2_subheading != blank %}
              <div class="ai-advanced-editorial__subheading-{{ ai_gen_id }}">
                {{ block.settings.section_2_subheading }}
              </div>
            {% endif %}
            {% if block.settings.section_2_heading != blank %}
              <h2 class="ai-advanced-editorial__heading-{{ ai_gen_id }}">
                {{ block.settings.section_2_heading }}
              </h2>
            {% endif %}
            {% if block.settings.section_2_text != blank %}
              <div class="ai-advanced-editorial__text-{{ ai_gen_id }}">
                {{ block.settings.section_2_text }}
              </div>
            {% endif %}
            {% if block.settings.section_2_button_text != blank %}
              <a href="{{ block.settings.section_2_button_link }}" class="ai-advanced-editorial__button-{{ ai_gen_id }}">
                {{ block.settings.section_2_button_text }}
              </a>
            {% endif %}
          </div>
          <div class="ai-advanced-editorial__image-wrapper-{{ ai_gen_id }} {% if block.settings.enable_parallax %}ai-advanced-editorial__parallax-{{ ai_gen_id }}{% endif %}">
            {% if block.settings.section_2_image %}
              <img
                src="{{ block.settings.section_2_image | image_url: width: 1600 }}"
                alt="{{ block.settings.section_2_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.section_2_image.width }}"
                height="{{ block.settings.section_2_image.height }}"
                class="ai-advanced-editorial__image-{{ ai_gen_id }}"
              >
              <div class="ai-advanced-editorial__image-overlay-{{ ai_gen_id }}"></div>
            {% else %}
              <div class="ai-advanced-editorial__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>

        {% if block.settings.show_divider and block.settings.section_3_enabled %}
          <div class="ai-advanced-editorial__divider-{{ ai_gen_id }}"></div>
        {% endif %}
      {% endif %}

      {% if block.settings.section_3_enabled %}
        <div class="ai-advanced-editorial__section-{{ ai_gen_id }} {% if block.settings.section_3_reverse %}reverse{% endif %}" data-section="3">
          <div class="ai-advanced-editorial__content-{{ ai_gen_id }}">
            {% if block.settings.section_3_subheading != blank %}
              <div class="ai-advanced-editorial__subheading-{{ ai_gen_id }}">
                {{ block.settings.section_3_subheading }}
              </div>
            {% endif %}
            {% if block.settings.section_3_heading != blank %}
              <h2 class="ai-advanced-editorial__heading-{{ ai_gen_id }}">
                {{ block.settings.section_3_heading }}
              </h2>
            {% endif %}
            {% if block.settings.section_3_text != blank %}
              <div class="ai-advanced-editorial__text-{{ ai_gen_id }}">
                {{ block.settings.section_3_text }}
              </div>
            {% endif %}
            {% if block.settings.section_3_button_text != blank %}
              <a href="{{ block.settings.section_3_button_link }}" class="ai-advanced-editorial__button-{{ ai_gen_id }}">
                {{ block.settings.section_3_button_text }}
              </a>
            {% endif %}
          </div>
          <div class="ai-advanced-editorial__image-wrapper-{{ ai_gen_id }} {% if block.settings.enable_parallax %}ai-advanced-editorial__parallax-{{ ai_gen_id }}{% endif %}">
            {% if block.settings.section_3_image %}
              <img
                src="{{ block.settings.section_3_image | image_url: width: 1600 }}"
                alt="{{ block.settings.section_3_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.section_3_image.width }}"
                height="{{ block.settings.section_3_image.height }}"
                class="ai-advanced-editorial__image-{{ ai_gen_id }}"
              >
              <div class="ai-advanced-editorial__image-overlay-{{ ai_gen_id }}"></div>
            {% else %}
              <div class="ai-advanced-editorial__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</advanced-editorial-{{ ai_gen_id }}>

<script>
  (function() {
    class AdvancedEditorial{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.sections = this.querySelectorAll('.ai-advanced-editorial__section-{{ ai_gen_id }}');
        this.parallaxElements = this.querySelectorAll('.ai-advanced-editorial__parallax-{{ ai_gen_id }}');
        this.enableParallax = {{ block.settings.enable_parallax }};
      }

      connectedCallback() {
        this.setupIntersectionObserver();
        if (this.enableParallax && this.parallaxElements.length > 0) {
          this.setupParallax();
        }
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.15
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, options);

        this.sections.forEach((section) => {
          observer.observe(section);
        });
      }

      setupParallax() {
        let ticking = false;

        const updateParallax = () => {
          this.parallaxElements.forEach((element) => {
            const rect = element.getBoundingClientRect();
            const scrollOffset = (window.innerHeight - rect.top) / window.innerHeight;
            element.style.setProperty('--scroll-offset', scrollOffset);
          });
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(updateParallax);
            ticking = true;
          }
        });

        updateParallax();
      }
    }

    customElements.define('advanced-editorial-{{ ai_gen_id }}', AdvancedEditorial{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Advanced editorial layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_tablet",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding (tablet)",
      "default": 60
