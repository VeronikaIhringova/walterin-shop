          "id": "gid://shopify/Metafield/164359269613897",
          "namespace": "walterin",
          "key": "notes",
          "type": "rich_text_field",
          "value": "{\"type\":\"root\",\"children\":[{\"type\":\"heading\",\"level\":3,\"children\":[{\"type\":\"text\",\"value\":\"Reading it on a screen\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"You get both files: a high-resolution PDF and a fixed-layout EPUB. The drawings keep their proportions on either one, which is the point — the pages were laid out as pages.\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"The contents page is clickable and every chapter has a jump link. It reads on a desktop, a tablet, a phone and on fixed-layout readers.\"}]},{\"type\":\"heading\",\"level\":3,\"children\":[{\"type\":\"text\",\"value\":\"As a gift\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"For someone who is going to Prague, or who has been and keeps talking about it.\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"The printed book is a softcover you can put in a coat pocket. If you need it to arrive by a particular day, write to us before you order and we will tell you whether it is possible.\"}]},{\"type\":\"heading\",\"level\":3,\"children\":[{\"type\":\"text\",\"value\":\"About Walter\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"Walter Ihring draws humour and caricature. The drawings travel to exhibitions abroad and every now and then come home with an award.\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"In 2015 came Walterin Bratislava, a city told in comics. Prague is the next city, and the tarot is the first deck.\"}]}]}"
