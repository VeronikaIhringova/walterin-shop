          "key": "included",
          "type": "rich_text_field",
          "value": "{\"type\":\"root\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"type\":\"text\",\"value\":\"Two editions of the same book.\"}]},{\"type\":\"list\",\"listType\":\"unordered\",\"children\":[{\"type\":\"list-item\",\"children\":[{\"type\":\"text\",\"value\":\"The printed book — softcover, 129 × 207 mm, 140 pages, full colour\"}]},{\"type\":\"list-item\",\"children\":[{\"type\":\"text\",\"value\":\"The eBook — a high‑resolution PDF and a fixed‑layout EPUB, both together\"}]},{\"type\":\"list-item\",\"children\":[{\"type\":\"text\",\"value\":\"In the eBook: a clickable contents page and a jump link on every chapter\"}]},{\"type\":\"list-item\",\"children\":[{\"type\":\"text\",\"value\":\"English or Czech — you choose before you order\"}]}]}]}"
