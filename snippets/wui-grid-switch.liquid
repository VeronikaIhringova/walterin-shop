{%- comment -%}
  TEMPORARY — preview only. Veronka, 6 October 2026.

  Lets the four phone layouts for the shopping row be compared on the real site
  without building four themes:

    ?grid=a   two per row, as now but tightened
    ?grid=b   one per row, full width
    ?grid=c   swipe row, the next card peeking in
    ?grid=d   1 + 2, the first product leading

  The value is written to <html data-grid>, which the CSS keys off. Nothing here
  renders for a visitor who has not typed the parameter: no parameter, no
  attribute, no switcher, and layout A is what the stylesheet does anyway.

  **Delete this snippet, its render in layout/theme.liquid and the TEMPORARY
  block in walterin-ui.css once a layout is chosen.**
{%- endcomment -%}
<script>
  (function () {
    try {
      var q = new URLSearchParams(location.search);
      var g = (q.get('grid') || '').toLowerCase();
      if (['a', 'b', 'c', 'd'].indexOf(g) === -1) return;
      document.documentElement.dataset.grid = g;

      // The switcher is built here rather than in Liquid so it carries the
      // current path and language with it: flipping a layout must not throw
      // Veronka back to the English home page.
      document.addEventListener('DOMContentLoaded', function () {
        var names = { a: 'A', b: 'B', c: 'C', d: 'D' };
        var nav = document.createElement('nav');
        nav.className = 'wui-gridswitch';
        nav.setAttribute('aria-label', 'Phone layout preview');
        var label = document.createElement('span');
        label.textContent = 'Layout';
        nav.appendChild(label);
        Object.keys(names).forEach(function (k) {
          var u = new URL(location.href);
          u.searchParams.set('grid', k);
          var a = document.createElement('a');
          a.href = u.toString();
          a.textContent = names[k];
          if (k === g) a.setAttribute('aria-current', 'true');
          nav.appendChild(a);
        });
        document.body.appendChild(nav);
      });
    } catch (e) {
      /* A comparison switch is never worth breaking a page for. */
    }
  })();
</script>
