{%- comment -%}
  Product card labels — the Quiet variation. Rules: docs/design/PRODUCT-CARD-SYSTEM.md.

  Accepts: product {Object}

  Two slots, and never more:
  - top right, at most ONE status pill. Sold out wins over New, always.
  - bottom, one wide flat bar carrying the date — and only when there is something true to say.
    A buyable product has nothing to add, so it gets no bar; hovering underlines the title instead.

  The bar is revealed on hover and on keyboard focus, and is visible from the start on touch, where
  there is no hover to depend on. That is CSS, not Liquid — see assets/walterin-ui.css.
{%- endcomment -%}
{%- liquid
  capture card_state
    render 'product-state', product: product
  endcapture
  assign card_state = card_state | strip

  capture launch_line
    render 'launch-date', product: product
  endcapture
  assign launch_line = launch_line | strip

  comment
    "New" runs for three months from the day the product was published and then removes itself.
    A New badge nobody takes down becomes a lie, so nobody is asked to take it down.
  endcomment
  assign is_new = false
  if product.published_at != blank
    assign new_until = product.published_at | date: '%s' | plus: 7776000
    assign now_seconds = 'now' | date: '%s' | plus: 0
    if new_until > now_seconds
      assign is_new = true
    endif
  endif

  assign bar_text = ''
  unless card_state == 'available'
    if launch_line != blank
      assign bar_text = launch_line
    elsif card_state == 'sold_out'
      assign bar_text = 'walterin.card.sold_out' | t
    else
      assign bar_text = 'walterin.launch.soon' | t
    endif
  endunless
-%}

{%- if card_state == 'sold_out' -%}
  <span class="wui-cl__status">
    {{- 'walterin.card.sold_out' | t -}}
    <span class="wui-sr"> — {{ 'walterin.card.sold_out_sr' | t }}</span>
  </span>
{%- elsif is_new -%}
  <span class="wui-cl__status">
    {{- 'walterin.card.new' | t -}}
    <span class="wui-sr"> — {{ 'walterin.card.new_sr' | t }}</span>
  </span>
{%- endif -%}

{%- if bar_text != blank -%}
  <span class="wui-cl__bar">{{ bar_text }}</span>
{%- endif -%}
