{% comment %}
  The one Walterin frame button: WalterinBold uppercase, 2.5px ink border,
  hard offset shadow that shrinks on hover and disappears on press.
  Styles live in assets/tarot-page.css (.wt-btn).

  Accepts:
  - label: {String} button content; may contain markup, e.g. a <span data-edname> (required)
  - href: {String} renders an <a> instead of a <button>
  - type: {String} 'button' (default) | 'submit'
  - fill: {String} 'yellow' (default) | 'white' (use white on yellow backgrounds)
  - size: {String} 'md' (default) | 'sm'
  - block: {Boolean} full width
  - class: {String} extra classes
  - attrs: {String} extra raw attributes (data-*, aria-*, form=, id=, disabled)

  Usage:
  {% render 'wt-button', label: 'Notify me', type: 'submit', size: 'sm' %}
  {% render 'wt-button', label: label_html, fill: 'white', attrs: 'data-focus-notify' %}
{% endcomment %}
{%- liquid
  assign classes = 'wt-btn'
  if fill == 'white'
    assign classes = classes | append: ' wt-btn--white'
  endif
  if size == 'sm'
    assign classes = classes | append: ' wt-btn--sm'
  endif
  if block
    assign classes = classes | append: ' wt-btn--block'
  endif
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}
{%- if href != blank -%}
  <a href="{{ href }}" class="{{ classes }}" {{ attrs }}>{{ label }}</a>
{%- else -%}
  <button type="{{ type | default: 'button' }}" class="{{ classes }}" {{ attrs }}>{{ label }}</button>
{%- endif -%}
