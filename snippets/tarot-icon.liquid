{% comment %}
  Line icons for the Comics Tarot page (2.2px ink stroke, 32px grid).

  Accepts:
  - icon: {String} 'edition' | 'payment' | 'shipping' | 'star'
  - class: {String} extra classes (default 't-icon')

  Usage:
  {% render 'tarot-icon', icon: 'shipping' %}
{% endcomment %}
{%- if icon == 'star' -%}
  <img src="{{ 'wi-star.png' | asset_url }}" alt="" width="20" height="20" loading="lazy" class="{{ class | default: 't-icon' }}">
{%- else -%}
  <svg class="{{ class | default: 't-icon' }}" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'edition' -%}
        <rect x="7" y="3" width="18" height="26" rx="3"/><path d="M12 10h8M12 15h8M12 20h5"/>
      {%- when 'payment' -%}
        <rect x="3" y="7" width="26" height="18" rx="2"/><path d="M3 12h26M8 20h6"/>
      {%- when 'shipping' -%}
        <path d="M16 3 4 9v14l12 6 12-6V9z"/><path d="M4 9l12 6 12-6M16 15v14"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
