{%- comment -%}
  TEMPORARY — preview only. Veronka, 6 October 2026.

  Lets two choices be compared on the real site without building two themes:

    ?card=cream | sand | sun     the card colour
    ?pill=a | b                  where the product page pill sits

  Both write a data attribute on <html>, which the CSS keys off. Nothing here
  reaches a visitor who does not type the parameter, and the defaults are the
  current build.

  **Delete this snippet, its render in layout/theme.liquid, the comparison CSS
  blocks in walterin-ui.css and the unused tokens once the choices are made.**
{%- endcomment -%}
<script>
  (function () {
    try {
      var q = new URLSearchParams(location.search);
      var card = q.get('card');
      var pill = q.get('pill');
      if (card && ['cream', 'sand', 'sun'].indexOf(card) !== -1) {
        document.documentElement.dataset.card = card;
      }
      if (pill && ['a', 'b'].indexOf(pill) !== -1) {
        document.documentElement.dataset.pill = pill;
      }
    } catch (e) {
      /* A comparison switch is never worth breaking a page for. */
    }
  })();
</script>
