{% doc %}
  @prompt
    Create a clean, editorial-style header section for my Shop page, similar to Rhode’s homepage.
    The layout should feature:
    A full-width background image with adjustable opacity and positioning.
    Centered headline text and optional subheadline over the image.
    Precise control over text size, weight, spacing, and color.
    Adjustable vertical and horizontal alignment (so I can move the text higher, lower, left, or right).
    Optional overlay color or gradient on the image for readability.
    The ability to toggle background parallax on or off.
    Full customization for desktop and mobile layout separately.
    Options for animation or subtle fade-in effects for both text and image.
    Make it simple, modern, and flexible — everything should be editable: image, text, size, colors, opacity, alignment, and margins.
    The overall look should be balanced, minimal, and elegant, with the focus on typography and composition rather than decoration.
    , make the text cnetred in the centre of the image, text centred horizntally and also vertically, so it needs to be in the cnetre of the image, not only vertcially but also horizontally
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-header-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: {{ block.settings.min_height_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-header-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }
  }

  .ai-editorial-header__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-editorial-header__image-wrapper-{{ ai_gen_id }}.parallax {
    {% if block.settings.enable_parallax %}
      background-attachment: fixed;
      background-position: {{ block.settings.image_position_horizontal }} {{ block.settings.image_position_vertical }};
      background-size: cover;
      background-repeat: no-repeat;
    {% endif %}
  }

  .ai-editorial-header__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position_horizontal }} {{ block.settings.image_position_vertical }};
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
    {% if block.settings.enable_image_animation %}
      opacity: 0;
      animation: ai-editorial-fade-in-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-out forwards;
      animation-delay: {{ block.settings.image_animation_delay }}s;
    {% endif %}
  }

  .ai-editorial-header__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    {% if block.settings.overlay_type == 'solid' %}
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    {% elsif block.settings.overlay_type == 'gradient' %}
      background: {{ block.settings.overlay_gradient }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    {% endif %}
  }

  .ai-editorial-header__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    padding: {{ block.settings.padding_top_desktop }}px {{ block.settings.padding_horizontal_desktop }}px {{ block.settings.padding_bottom_desktop }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-header__content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
      align-items: {{ block.settings.vertical_alignment_mobile }};
      justify-content: {{ block.settings.horizontal_alignment_mobile }};
      text-align: {{ block.settings.text_alignment_mobile }};
    }
  }

  .ai-editorial-header__text-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
    {% if block.settings.enable_text_animation %}
      opacity: 0;
      transform: translateY(20px);
      animation: ai-editorial-fade-up-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-out forwards;
      animation-delay: {{ block.settings.text_animation_delay }}s;
    {% endif %}
  }

  .ai-editorial-header__headline-{{ ai_gen_id }} {
    font-family: {{ block.settings.headline_font.family }}, {{ block.settings.headline_font.fallback_families }};
    font-weight: {{ block.settings.headline_font.weight }};
    font-size: {{ block.settings.headline_size_desktop }}px;
    line-height: {{ block.settings.headline_line_height }};
    letter-spacing: {{ block.settings.headline_letter_spacing }}em;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_spacing }}px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-header__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size_mobile }}px;
    }
  }

  .ai-editorial-header__subheadline-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheadline_font.family }}, {{ block.settings.subheadline_font.fallback_families }};
    font-weight: {{ block.settings.subheadline_font.weight }};
    font-size: {{ block.settings.subheadline_size_desktop }}px;
    line-height: {{ block.settings.subheadline_line_height }};
    letter-spacing: {{ block.settings.subheadline_letter_spacing }}em;
    color: {{ block.settings.subheadline_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-header__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size_mobile }}px;
    }
  }

  {% if block.settings.enable_image_animation %}
    @keyframes ai-editorial-fade-in-{{ ai_gen_id }} {
      from {
        opacity: 0;
      }
      to {
        opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
      }
    }
  {% endif %}

  {% if block.settings.enable_text_animation %}
    @keyframes ai-editorial-fade-up-{{ ai_gen_id }} {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  {% endif %}
{% endstyle %}

<div class="ai-editorial-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-header__image-wrapper-{{ ai_gen_id }} {% if block.settings.enable_parallax and block.settings.background_image %}parallax{% endif %}" 
    {% if block.settings.enable_parallax and block.settings.background_image %}
      style="background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');"
    {% endif %}
  >
    {% if block.settings.background_image %}
      {% unless block.settings.enable_parallax %}
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          alt="{{ block.settings.background_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          class="ai-editorial-header__image-{{ ai_gen_id }}"
        >
      {% endunless %}
    {% else %}
      <div class="ai-editorial-header__placeholder-{{ ai_gen_id }}" style="width: 100%; height: 100%; background-color: #f4f4f4; display: flex; align-items: center; justify-content: center;">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.overlay_type != 'none' %}
    <div class="ai-editorial-header__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-editorial-header__content-{{ ai_gen_id }}">
    <div class="ai-editorial-header__text-wrapper-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h1 class="ai-editorial-header__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h1>
      {% endif %}

      {% if block.settings.subheadline != blank %}
        <div class="ai-editorial-header__subheadline-{{ ai_gen_id }}">
          {{ block.settings.subheadline }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
