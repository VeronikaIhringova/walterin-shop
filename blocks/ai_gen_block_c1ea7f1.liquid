{% doc %}
  @prompt
    header im\ge centred white headline, only one healdine no subeheading, cenrted right in the centre, possible to make visible and not visible, next give me the exact image size, so I can fit my image there and make some animation, like a slide animation with this also possibel to turn on and off.
    plus options for the phone version please, like how does the image fit or the option of a different image, also we need the to edit the distances between the image and the text, plus lets make something fun like when the mouse enters hovers the image it dissappears and then appears again or something like this (could be turned off)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-header-image__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-header-image__content-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.spacing_between }}px;
  }

  .ai-header-image__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_width }}px;
    {% if block.settings.enable_animation %}
      opacity: 0;
      transform: translateX({{ block.settings.animation_direction }});
      animation: ai-slide-in-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-out forwards;
      animation-delay: {{ block.settings.animation_delay }}s;
    {% endif %}
    {% if block.settings.enable_hover_effect %}
      cursor: pointer;
      transition: opacity 0.3s ease, transform 0.3s ease;
    {% endif %}
  }

  {% if block.settings.enable_hover_effect %}
    {% if block.settings.hover_effect == 'fade' %}
      .ai-header-image__image-wrapper-{{ ai_gen_id }}:hover {
        opacity: 0;
      }
      .ai-header-image__image-wrapper-{{ ai_gen_id }}:not(:hover) {
        animation: ai-fade-back-{{ ai_gen_id }} 0.3s ease-out;
      }
      @keyframes ai-fade-back-{{ ai_gen_id }} {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    {% elsif block.settings.hover_effect == 'blink' %}
      .ai-header-image__image-wrapper-{{ ai_gen_id }}:hover {
        animation: ai-blink-{{ ai_gen_id }} 0.6s ease-in-out;
      }
      @keyframes ai-blink-{{ ai_gen_id }} {
        0%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }
    {% elsif block.settings.hover_effect == 'pulse' %}
      .ai-header-image__image-wrapper-{{ ai_gen_id }}:hover {
        animation: ai-pulse-{{ ai_gen_id }} 0.8s ease-in-out;
      }
      @keyframes ai-pulse-{{ ai_gen_id }} {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
        }
        25% {
          opacity: 0.3;
          transform: scale(0.95);
        }
        50% {
          opacity: 0;
          transform: scale(0.9);
        }
        75% {
          opacity: 0.3;
          transform: scale(0.95);
        }
      }
    {% elsif block.settings.hover_effect == 'flip' %}
      .ai-header-image__image-wrapper-{{ ai_gen_id }}:hover {
        animation: ai-flip-{{ ai_gen_id }} 0.6s ease-in-out;
      }
      @keyframes ai-flip-{{ ai_gen_id }} {
        0%, 100% {
          opacity: 1;
          transform: rotateY(0deg);
        }
        50% {
          opacity: 0;
          transform: rotateY(90deg);
        }
      }
    {% endif %}
  {% endif %}

  .ai-header-image__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-header-image__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-header-image__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-header-image__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-header-image__headline-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 600;
    text-align: center;
    margin: 0;
    line-height: 1.2;
  }

  @keyframes ai-slide-in-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-header-image__container-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px 20px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-header-image__content-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_spacing_between }}px;
    }

    .ai-header-image__image-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-header-image__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_headline_size }}px;
    }

    {% if block.settings.mobile_image_fit == 'contain' %}
      .ai-header-image__image-{{ ai_gen_id }} {
        object-fit: contain;
        max-height: {{ block.settings.mobile_max_height }}px;
      }
    {% elsif block.settings.mobile_image_fit == 'cover' %}
      .ai-header-image__image-{{ ai_gen_id }} {
        object-fit: cover;
        height: {{ block.settings.mobile_max_height }}px;
      }
    {% endif %}

    {% if block.settings.mobile_image_fit == 'contain' or block.settings.mobile_image_fit == 'cover' %}
      .ai-header-image__placeholder-{{ ai_gen_id }} {
        height: {{ block.settings.mobile_max_height }}px;
        aspect-ratio: auto;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-header-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-image__container-{{ ai_gen_id }}">
    <div class="ai-header-image__content-{{ ai_gen_id }}">
      {% if block.settings.show_headline %}
        <h1 class="ai-header-image__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h1>
      {% endif %}

      {% if block.settings.show_image %}
        <div class="ai-header-image__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 2000 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-header-image__image-{{ ai_gen_id }}"
            >
          {% elsif block.settings.mobile_image == blank %}
            <div class="ai-header-image__placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              <div class="ai-header-image__empty-state-{{ ai_gen_id }}">
                Add your header image (recommended: {{ block.settings.image_width }}px × {{ block.settings.image_width | divided_by: block.settings.image_aspect_ratio | round }}px)
              </div>
            </div>
          {% endif %}
        </div>

        {% if block.settings.mobile_image %}
          <div class="ai-header-image__image-wrapper-{{ ai_gen_id }} ai-header-image__mobile-only-{{ ai_gen_id }}" style="display: none;">
            <img
              src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
              alt="{{ block.settings.mobile_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.mobile_image.width }}"
              height="{{ block.settings.mobile_image.height }}"
              class="ai-header-image__image-{{ ai_gen_id }}"
            >
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% if block.settings.mobile_image %}
  <style>
    @media screen and (max-width: 749px) {
      .ai-header-image__image-wrapper-{{ ai_gen_id }}:not(.ai-header-image__mobile-only-{{ ai_gen_id }}) {
        display: none;
      }
      .ai-header-image__mobile-only-{{ ai_gen_id }} {
        display: block !important;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Header image",
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "checkbox",
      "id": "show_headline",
      "label": "Show headline",
      "default": true
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline text",
      "default": "Welcome to Our Store"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop headline size",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_headline_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile headline size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 400,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "label": "Maximum image width",
      "default": 1200,
      "info": "Recommended image size: 1200px × 675px (16:9 ratio)"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1.78",
          "label": "16:9 (Landscape)"
        },
        {
          "value": "1.33",
          "label": "4:3"
        },
        {
          "value": "1",
          "label": "1:1 (Square)"
        },
        {
          "value": "0.75",
          "label": "3:4 (Portrait)"
        }
      ],
      "default": "1.78",
      "info": "This sets the placeholder dimensions"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional: Use a different image for mobile devices"
    },
    {
      "type": "select",
      "id": "mobile_image_fit",
      "label": "Mobile image fit",
      "options": [
        {
          "value": "auto",
          "label": "Auto (full width)"
        },
        {
          "value": "contain",
          "label": "Contain (fit within height)"
        },
        {
          "value": "cover",
          "label": "Cover (fill height)"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "mobile_max_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Mobile max height",
      "default": 400,
      "info": "Only applies when image fit is set to Contain or Cover"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_between",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Desktop spacing between headline and image",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_spacing_between",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Mobile spacing between headline and image",
      "default": 20
    },
    {
      "type": "header",
      "content": "Hover effect"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_effect",
      "label": "Enable hover effect",
      "default": true
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect style",
      "options": [
        {
          "value": "fade",
          "label": "Fade out and back"
        },
        {
          "value": "blink",
          "label": "Blink"
        },
        {
          "value": "pulse",
          "label": "Pulse"
        },
        {
          "value": "flip",
          "label": "Flip"
        }
      ],
      "default": "fade"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable slide animation",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Animation direction",
      "options": [
        {
          "value": "-100px",
          "label": "Slide from left"
        },
        {
          "value": "100px",
          "label": "Slide from right"
        }
      ],
      "default": "-100px"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "label": "Animation duration",
      "default": 1
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "label": "Animation delay",
      "default": 0.2
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum content width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Header image"
    }
  ],
  "tag": null
}
{% endschema %}
