{% doc %}
  @prompt
    Create a clean, minimal and premium “Product Summary” block for my product page.
    This block should appear directly under the product variants.
    Keep it short, clear, and elegant.
    No icons — only text.
    Use the following points exactly as written:
    
    Walterin Prague — Summary
    
    160+ illustrated pages
    
    Short 9-frame stories on every page
    
    Humour, history and hidden details
    
    Original hand-drawn illustrations
    
    Perfect for culture lovers and travellers
    
    Available as eBook (EN + CZ) or Printed Book (EN or CZ)
    
    Design requirements:
    
    Clean, premium typography
    
    Good spacing between each bullet point
    
    Left-aligned or centered depending on theme
    
    Modern, minimal aesthetic (Walterin style)
    
    Should look beautiful on both mobile and desktop
    
    Soft divider line above and below the section (optional)
    
    Add this section directly below the variant selector and pricing., make margins also for the left and right unlimited to both sides
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-summary-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_left }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_right }}px;
    margin: {{ block.settings.margin_top }}px {{ block.settings.margin_right }}px {{ block.settings.margin_bottom }}px {{ block.settings.margin_left }}px;
    border-top: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
    border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-product-summary__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_transform }};
  }

  .ai-product-summary__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-product-summary__item-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    font-weight: {{ block.settings.text_weight }};
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-summary-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_left | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px {{ block.settings.padding_right | times: 0.7 }}px;
      margin: {{ block.settings.margin_top | times: 0.7 }}px {{ block.settings.margin_right | times: 0.7 }}px {{ block.settings.margin_bottom | times: 0.7 }}px {{ block.settings.margin_left | times: 0.7 }}px;
    }

    .ai-product-summary__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
      margin-bottom: {{ block.settings.title_spacing | times: 0.8 }}px;
    }

    .ai-product-summary__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-product-summary__list-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-summary-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h3 class="ai-product-summary__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h3>
  {% endif %}

  <ul class="ai-product-summary__list-{{ ai_gen_id }}">
    {% if block.settings.item_1 != blank %}
      <li class="ai-product-summary__item-{{ ai_gen_id }}">
        {{ block.settings.item_1 }}
      </li>
    {% endif %}

    {% if block.settings.item_2 != blank %}
      <li class="ai-product-summary__item-{{ ai_gen_id }}">
        {{ block.settings.item_2 }}
      </li>
    {% endif %}

    {% if block.settings.item_3 != blank %}
      <li class="ai-product-summary__item-{{ ai_gen_id }}">
        {{ block.settings.item_3 }}
      </li>
    {% endif %}

    {% if block.settings.item_4 != blank %}
      <li class="ai-product-summary__item-{{ ai_gen_id }}">
        {{ block.settings.item_4 }}
      </li>
    {% endif %}

    {% if block.settings.item_5 != blank %}
      <li class="ai-product-summary__item-{{ ai_gen_id }}">
        {{ block.settings.item_5 }}
      </li>
    {% endif %}

    {% if block.settings.item_6 != blank %}
      <li class="ai-product-summary__item-{{ ai_gen_id }}">
        {{ block.settings.item_6 }}
      </li>
    {% endif %}
  </ul>
</div>

