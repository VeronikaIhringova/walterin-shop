{% doc %}
  @prompt
    Create a fully customizable Shopify section called “Four Image Gallery.”
    
    The section should show 4 images side by side on desktop (modern, minimal look) and automatically switch to a 2×2 square grid on mobile (two on top, two below).
    Each image must stay fully visible at all times (no cropping).
    
    🖼️ Individual image controls:
    Each image must have options in the theme editor to:
    
    Upload image
    
    Adjust width and height (default 200×200px, maintain aspect ratio)
    
    Adjust margins (top/bottom/left/right from –200px to +200px)
    
    Adjust padding (0–100px)
    
    Adjust gap (–100px to +100px, allows overlap)
    
    Adjust corner radius (0–50px)
    
    Add an optional link
    
    🧩 Section-wide controls:
    
    Top & bottom padding (0–200px)
    
    Left & right margins (–200px to +200px)
    
    Global gap between images (–100px to +100px)
    
    Optional heading, subheading, text color, and background color
    
    🖥️ Desktop behavior:
    
    4 images in a single row (flex or grid).
    
    Hover zoom effect that never crops:
    
    transform: scale(1.05);
    object-fit: contain;
    transition: transform 0.4s ease-in-out;
    overflow: visible;
    
    
    📱 Mobile behavior:
    
    Layout becomes 2×2 grid.
    
    Add mobile-only controls for each image:
    
    Mobile width & height (default 250×250px, adjustable)
    
    Mobile margins (top/bottom/left/right from –200px to +200px)
    
    Mobile padding (0–100px)
    
    These must be independent from desktop settings.
    
    🎞️ Mobile animation:
    Since there’s no hover, add an automatic sequential zoom animation:
    
    Order: top-left → top-right → bottom-left → bottom-right
    
    Each image zooms to scale(1.05) and back to normal in ~1s
    
    Delay each by 0.3–0.5s
    
    Wait 3s before restarting
    
    Smooth, elegant, looping “living gallery” effect
    
    Example CSS:
    
    @keyframes slowZoom {
      0%,100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .image-block:nth-child(1) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 0s; }
    .image-block:nth-child(2) img { animation: slowZoom 8s ease-in-out infinite; animation-delay: 1s; }
    .image-block:nth-child(3) img 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-gallery-{{ ai_gen_id }} {
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    margin-left: {{ block.settings.section_margin_left }}px;
    margin-right: {{ block.settings.section_margin_right }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-four-gallery__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-four-gallery__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    font-size: 32px;
  }

  .ai-four-gallery__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: 16px;
    opacity: 0.8;
  }

  .ai-four-gallery__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: {{ block.settings.global_gap }}px;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  .ai-four-gallery__item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    overflow: visible;
  }

  .ai-four-gallery__link-{{ ai_gen_id }} {
    display: block;
    overflow: visible;
  }

  .ai-four-gallery__image-wrapper-{{ ai_gen_id }} {
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-gallery__image-{{ ai_gen_id }} {
    display: block;
    object-fit: contain;
    transition: transform 0.4s ease-in-out;
  }

  .ai-four-gallery__image-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-four-gallery__item-1-{{ ai_gen_id }} {
    margin-top: {{ block.settings.image_1_margin_top }}px;
    margin-bottom: {{ block.settings.image_1_margin_bottom }}px;
    margin-left: {{ block.settings.image_1_margin_left }}px;
    margin-right: {{ block.settings.image_1_margin_right }}px;
    padding: {{ block.settings.image_1_padding }}px;
  }

  .ai-four-gallery__item-1-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_1_width }}px;
    height: {{ block.settings.image_1_height }}px;
    border-radius: {{ block.settings.image_1_radius }}px;
  }

  .ai-four-gallery__item-2-{{ ai_gen_id }} {
    margin-top: {{ block.settings.image_2_margin_top }}px;
    margin-bottom: {{ block.settings.image_2_margin_bottom }}px;
    margin-left: {{ block.settings.image_2_margin_left }}px;
    margin-right: {{ block.settings.image_2_margin_right }}px;
    padding: {{ block.settings.image_2_padding }}px;
  }

  .ai-four-gallery__item-2-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_2_width }}px;
    height: {{ block.settings.image_2_height }}px;
    border-radius: {{ block.settings.image_2_radius }}px;
  }

  .ai-four-gallery__item-3-{{ ai_gen_id }} {
    margin-top: {{ block.settings.image_3_margin_top }}px;
    margin-bottom: {{ block.settings.image_3_margin_bottom }}px;
    margin-left: {{ block.settings.image_3_margin_left }}px;
    margin-right: {{ block.settings.image_3_margin_right }}px;
    padding: {{ block.settings.image_3_padding }}px;
  }

  .ai-four-gallery__item-3-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_3_width }}px;
    height: {{ block.settings.image_3_height }}px;
    border-radius: {{ block.settings.image_3_radius }}px;
  }

  .ai-four-gallery__item-4-{{ ai_gen_id }} {
    margin-top: {{ block.settings.image_4_margin_top }}px;
    margin-bottom: {{ block.settings.image_4_margin_bottom }}px;
    margin-left: {{ block.settings.image_4_margin_left }}px;
    margin-right: {{ block.settings.image_4_margin_right }}px;
    padding: {{ block.settings.image_4_padding }}px;
  }

  .ai-four-gallery__item-4-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_4_width }}px;
    height: {{ block.settings.image_4_height }}px;
    border-radius: {{ block.settings.image_4_radius }}px;
  }

  .ai-four-gallery__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .ai-four-gallery__container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ block.settings.global_gap }}px;
    }

    .ai-four-gallery__item-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-four-gallery__image-{{ ai_gen_id }}:hover {
      transform: none;
    }

    .ai-four-gallery__item-1-{{ ai_gen_id }} {
      margin-top: {{ block.settings.image_1_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_1_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_1_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_1_mobile_margin_right }}px;
      padding: {{ block.settings.image_1_mobile_padding }}px;
    }

    .ai-four-gallery__item-1-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_1_mobile_width }}px;
      height: {{ block.settings.image_1_mobile_height }}px;
    }

    .ai-four-gallery__item-2-{{ ai_gen_id }} {
      margin-top: {{ block.settings.image_2_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_2_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_2_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_2_mobile_margin_right }}px;
      padding: {{ block.settings.image_2_mobile_padding }}px;
    }

    .ai-four-gallery__item-2-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_2_mobile_width }}px;
      height: {{ block.settings.image_2_mobile_height }}px;
    }

    .ai-four-gallery__item-3-{{ ai_gen_id }} {
      margin-top: {{ block.settings.image_3_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_3_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_3_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_3_mobile_margin_right }}px;
      padding: {{ block.settings.image_3_mobile_padding }}px;
    }

    .ai-four-gallery__item-3-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_3_mobile_width }}px;
      height: {{ block.settings.image_3_mobile_height }}px;
    }

    .ai-four-gallery__item-4-{{ ai_gen_id }} {
      margin-top: {{ block.settings.image_4_mobile_margin_top }}px;
      margin-bottom: {{ block.settings.image_4_mobile_margin_bottom }}px;
      margin-left: {{ block.settings.image_4_mobile_margin_left }}px;
      margin-right: {{ block.settings.image_4_mobile_margin_right }}px;
      padding: {{ block.settings.image_4_mobile_padding }}px;
    }

    .ai-four-gallery__item-4-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_4_mobile_width }}px;
      height: {{ block.settings.image_4_mobile_height }}px;
    }

    @keyframes ai-gallery-zoom-{{ ai_gen_id }} {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .ai-four-gallery__item-1-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      animation: ai-gallery-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 0s;
    }

    .ai-four-gallery__item-2-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      animation: ai-gallery-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 1s;
    }

    .ai-four-gallery__item-3-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      animation: ai-gallery-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 2s;
    }

    .ai-four-gallery__item-4-{{ ai_gen_id }} .ai-four-gallery__image-{{ ai_gen_id }} {
      animation: ai-gallery-zoom-{{ ai_gen_id }} 8s ease-in-out infinite;
      animation-delay: 3s;
    }
  }
{% endstyle %}

<div class="ai-four-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-four-gallery__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-four-gallery__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-four-gallery__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-four-gallery__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'image_' | append: i | append: '_link'
        assign image = block.settings[image_key]
        assign link = block.settings[link_key]
      %}

      <div class="ai-four-gallery__item-{{ ai_gen_id }} ai-four-gallery__item-{{ i }}-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-four-gallery__link-{{ ai_gen_id }}">
        {% endif %}

        <div class="ai-four-gallery__image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="800"
              height="800"
              class="ai-four-gallery__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-four-gallery__placeholder-{{ ai_gen_id }} ai-four-gallery__image-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

