{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-row-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 8px;
    padding: 24px;
    background-color: transparent;
    position: relative;
    filter: grayscale(1);
  }

  .ai-feature-item-{{ ai_gen_id }}:hover {
    filter: grayscale(0);
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    filter: grayscale(0);
    box-shadow: 0 0 40px 15px var(--expanded-bg-color);
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--expanded-bg-color);
    border-radius: 8px;
    z-index: -1;
    opacity: 0.95;
  }

  .ai-feature-content-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-left-top {
    flex-direction: row;
    align-items: flex-start;
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-left-center {
    flex-direction: row;
    align-items: center;
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-left-bottom {
    flex-direction: row;
    align-items: flex-end;
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-top-left {
    flex-direction: column;
    align-items: flex-start;
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-top-center {
    flex-direction: column;
    align-items: center;
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-bottom-left {
    flex-direction: column-reverse;
    align-items: flex-start;
  }

  .ai-feature-content-{{ ai_gen_id }}.layout-bottom-center {
    flex-direction: column-reverse;
    align-items: center;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-content-{{ ai_gen_id }}.align-center {
    flex-direction: column;
    align-items: center;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-content-{{ ai_gen_id }}.align-left {
    flex-direction: column;
    align-items: flex-start;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-content-{{ ai_gen_id }}.align-right {
    flex-direction: column;
    align-items: flex-end;
  }

  .ai-feature-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    margin-bottom: {{ block.settings.icon_spacing }}px;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-icon-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.expanded_icon_spacing }}px;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    height: auto;
    display: block;
  }

  .ai-feature-text-{{ ai_gen_id }} {
    flex-grow: 1;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .layout-top-center .ai-feature-text-{{ ai_gen_id }},
  .layout-bottom-center .ai-feature-text-{{ ai_gen_id }} {
    text-align: center;
  }

  .layout-left-top .ai-feature-text-{{ ai_gen_id }},
  .layout-left-center .ai-feature-text-{{ ai_gen_id }},
  .layout-left-bottom .ai-feature-text-{{ ai_gen_id }},
  .layout-top-left .ai-feature-text-{{ ai_gen_id }},
  .layout-bottom-left .ai-feature-text-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-text-{{ ai_gen_id }} {
    text-align: {{ block.settings.expanded_text_alignment }};
  }

  .ai-feature-heading-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: 18px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    color: {{ block.settings.heading_color }};
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-heading-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.expanded_heading_spacing }}px;
  }

  .ai-feature-preview-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    color: {{ block.settings.text_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: 1;
    max-height: 100px;
    transition: opacity 0.2s ease, max-height 0.3s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-preview-{{ ai_gen_id }} {
    opacity: 0;
    max-height: 0;
    margin: 0;
    overflow: hidden;
  }

  .ai-feature-read-more-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 500;
    margin-top: 8px;
    display: inline-block;
    opacity: 1;
    max-height: 30px;
    transition: opacity 0.2s ease, max-height 0.3s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-read-more-{{ ai_gen_id }} {
    opacity: 0;
    max-height: 0;
    margin: 0;
    overflow: hidden;
  }

  .ai-feature-placeholder-{{ ai_gen_id }} {
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-feature-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-expanded-content-{{ ai_gen_id }} {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-expanded-content-{{ ai_gen_id }} {
    max-height: 2000px;
    opacity: 1;
    margin-top: {{ block.settings.content_spacing }}px;
    text-align: {{ block.settings.expanded_text_alignment }};
    transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.1s, opacity 0.5s ease 0.2s;
  }

  .ai-feature-banner-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    border-radius: 8px;
    margin-bottom: {{ block.settings.banner_spacing }}px;
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-banner-{{ ai_gen_id }} {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.3s, opacity 0.5s ease 0.3s;
  }

  .ai-feature-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    margin-bottom: {{ block.settings.banner_spacing }}px;
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-banner-placeholder-{{ ai_gen_id }} {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.3s, opacity 0.5s ease 0.3s;
  }

  .ai-feature-banner-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-feature-full-text-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin-bottom: {{ block.settings.text_spacing }}px;
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-full-text-{{ ai_gen_id }} {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.4s, opacity 0.5s ease 0.4s;
  }

  .ai-feature-full-text-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-feature-full-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-feature-read-less-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 500;
    display: inline-block;
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}.expanded .ai-feature-read-less-{{ ai_gen_id }} {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.5s, opacity 0.5s ease 0.5s;
  }

  @media screen and (max-width: 899px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-feature-content-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-feature-text-{{ ai_gen_id }} {
      text-align: left;
    }

    .ai-feature-banner-{{ ai_gen_id }},
    .ai-feature-banner-placeholder-{{ ai_gen_id }} {
      height: 150px;
    }
  }
{% endstyle %}

<features-row-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-features-row-{{ ai_gen_id }}">
    <div class="ai-features-container-{{ ai_gen_id }}">
      <div class="ai-features-grid-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign icon_key = 'icon_' | append: i
            assign icon_width_key = 'icon_width_' | append: i
            assign heading_key = 'heading_' | append: i
            assign preview_key = 'preview_' | append: i
            assign banner_key = 'banner_' | append: i
            assign show_banner_key = 'show_banner_' | append: i
            assign full_text_key = 'full_text_' | append: i
            assign expanded_bg_key = 'expanded_background_' | append: i

            assign icon = block.settings[icon_key]
            assign icon_width = block.settings[icon_width_key]
            assign heading = block.settings[heading_key]
            assign preview = block.settings[preview_key]
            assign banner = block.settings[banner_key]
            assign show_banner = block.settings[show_banner_key]
            assign full_text = block.settings[full_text_key]
            assign expanded_bg = block.settings[expanded_bg_key]
          %}

          <div
            class="ai-feature-item-{{ ai_gen_id }}"
            data-feature="{{ i }}"
            style="--expanded-bg-color: {{ expanded_bg }};"
          >
            <div class="ai-feature-content-{{ ai_gen_id }} layout-{{ block.settings.icon_position }} align-{{ block.settings.expanded_text_alignment }}" data-header>
              <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
                {% if icon %}
                  <img
                    src="{{ icon | image_url: width: 240 }}"
                    alt="{{ icon.alt | default: heading | escape }}"
                    class="ai-feature-icon-{{ ai_gen_id }}"
                    style="width: {{ icon_width }}px;"
                    width="{{ icon_width }}"
                    height="{{ icon_width }}"
                    loading="lazy"
                  >
                {% else %}
                  <div class="ai-feature-placeholder-{{ ai_gen_id }}" style="width: {{ icon_width }}px; height: {{ icon_width }}px;">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-feature-text-{{ ai_gen_id }}">
                {% if heading != blank %}
                  <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ heading }}</h3>
                {% endif %}

                {% if preview != blank %}
                  <div class="ai-feature-preview-{{ ai_gen_id }}">
                    {{ preview }}
                  </div>
                  <span class="ai-feature-read-more-{{ ai_gen_id }}">Read more →</span>
                {% endif %}
              </div>
            </div>

            <div class="ai-feature-expanded-content-{{ ai_gen_id }}" data-expanded>
              {% if show_banner %}
                {% if banner %}
                  <img
                    src="{{ banner | image_url: width: 1400 }}"
                    alt="{{ banner.alt | default: heading | escape }}"
                    class="ai-feature-banner-{{ ai_gen_id }}"
                    width="1400"
                    height="200"
                    loading="lazy"
                  >
                {% else %}
                  <div class="ai-feature-banner-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% endif %}

              {% if full_text != blank %}
                <div class="ai-feature-full-text-{{ ai_gen_id }}">
                  {{ full_text }}
                </div>
              {% endif %}

              <span class="ai-feature-read-less-{{ ai_gen_id }}">Read less ←</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</features-row-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturesRow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.features = this.querySelectorAll('[data-feature]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.features.forEach((feature) => {
          const header = feature.querySelector('[data-header]');
          const expanded = feature.querySelector('[data-expanded]');

          header.addEventListener('click', (e) => {
            e.stopPropagation();
            if (feature.classList.contains('expanded')) {
              this.closeFeature(feature);
            } else {
              this.expandFeature(feature);
            }
          });

          expanded.addEventListener('click', (e) => {
            e.stopPropagation();
            this.closeFeature(feature);
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('[data-feature]')) {
            this.closeAllFeatures();
          }
        });
      }

      expandFeature(feature) {
        this.features.forEach((f) => {
          if (f !== feature) {
            f.classList.remove('expanded');
          }
        });
        feature.classList.add('expanded');
      }

      closeFeature(feature) {
        feature.classList.remove('expanded');
      }

      closeAllFeatures() {
        this.features.forEach((f) => {
          f.classList.remove('expanded');
        });
      }
    }

    customElements.define('features-row-{{ ai_gen_id }}', FeaturesRow{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
