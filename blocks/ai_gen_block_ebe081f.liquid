      "id": "zoom_scale",
      "min": 1.5,
      "max": 3,
      "step": 0.1,
      "label": "Zoom level",
      "default": 2
    },
    {
      "type": "range",
      "id": "lens_size",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Lens size",
      "default": 180
    },
    {
      "type": "range",
      "id": "lens_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Lens border radius",
      "default": 4
    },
    {
      "type": "color",
      "id": "lens_border_color",
      "label": "Lens border color",
      "default": "#222222"
    }
  ],
  "presets": [
    {
      "name": "Zoom image"
    }
  ]
}
{% endschema %}